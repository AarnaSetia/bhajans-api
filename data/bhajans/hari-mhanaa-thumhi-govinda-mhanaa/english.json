{
  "id": "hari-mhanaa-thumhi-govinda-mhanaa",
  "title": "Hari Mhanaa Thumhi Govinda Mhanaa",
  "lyrics": [
    {
      "type": "verse",
      "lines": [
        "Hari Mhanaa Thumhi Govinda Mhanaa,",
        "Thumhi Gopal Mhanaa Hari Narayana ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "Govinda Gopal Hari Narayana ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Shyam Mhanaa, Ghana Shyam Mhanaa,",
        "Radhe Shyam Mhanaa Meghashyam Mhanaa ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "Govinda Gopal Hari Narayana ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Ram Mhanaa Raja Ram Mhanaa,",
        "Sitaram Mhanaa, Athmaram Mhanaa ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "Govinda Gopal Hari Narayana ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Datha Mhanaa, Guru Datha Mhanaa,",
        "Sri Padh Mhanaa, Gurudev Mhanaa ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "Govinda Gopal Hari Narayana ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Isha Mhanaa, Jagadeesha Mhanaa,",
        "Sarvesha Mhanaa, Paramesha Mhanaa ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "Govinda Gopal Hari Narayana ।"
      ]
    }
  ]
}

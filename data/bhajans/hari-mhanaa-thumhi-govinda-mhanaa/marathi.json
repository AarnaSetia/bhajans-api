{
  "id": "hari-mhanaa-thumhi-govinda-mhanaa",
  "title": "हरि म्हणा तुम्ही गोविंद म्हणा",
  "lyrics": [
    {
      "type": "verse",
      "lines": [
        "हरि म्हणा तुम्ही गोविंद म्हणा,",
        "तुम्ही गोपाळ म्हणा हरि नारायणा ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "गोविंद गोपाळ हरि नारायणा ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "श्याम म्हणा घनश्याम म्हणा,",
        "राधेश्याम म्हणा मेघश्याम म्हणा ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "गोविंद गोपाळ हरि नारायणा ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "राम म्हणा राजाराम म्हणा,",
        "सीताराम म्हणा आत्माराम म्हणा ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "गोविंद गोपाळ हरि नारायणा ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "दत्त म्हणा गुरुदत्त म्हणा,",
        "श्रीपाद म्हणा गुरुदेव म्हणा ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "गोविंद गोपाळ हरि नारायणा ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "ईशा म्हणा जगदीशा म्हणा,",
        "सर्वेशा म्हणा परमेशा म्हणा ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "गोविंद गोपाळ हरि नारायणा ।"
      ]
    }
  ]
}

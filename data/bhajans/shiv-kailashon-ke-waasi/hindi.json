{
  "id": "shiv-kailashon-ke-waasi",
  "title": "शिव कैलाशों के वासी",
  "lyrics": [
    {
      "type": "chorus",
      "lines": [
        "शिव कैलाशों के वासी,",
        "धौलधारों के राजा,",
        "शंकर संकट हरना,",
        "शंकर संकट हरना ॥"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "तेरे कैलाशों का अंत ना पाया,",
        "तेरे कैलाशों का अंत ना पाया,",
        "अंत बेअंत तेरी माया, ओ भोले बाबा,",
        "अंत बेअंत तेरी माया ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "शिव कैलाशों के वासी,",
        "धौलधारों के राजा,",
        "शंकर संकट हरना,",
        "शंकर संकट हरना ॥"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "बेल की पत्तियां भांग धतूरा,",
        "बेल की पत्तियां भांग धतूरा,",
        "शिव जी के मन को लुभाएं, ओ भोले बाबा,",
        "शिव जी के मन को लुभाएं ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "शिव कैलाशों के वासी,",
        "धौलधारों के राजा,",
        "शंकर संकट हरना,",
        "शंकर संकट हरना ॥"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "एक था डेरा तेरा, चम्बे दे चौगाना,",
        "एक था डेरा तेरा, चम्बे दे चौगाना,",
        "दूजा लाई बैठा भरमौरा, ओ भोले बाबा,",
        "दूजा लाई बैठा भरमौरा ।"

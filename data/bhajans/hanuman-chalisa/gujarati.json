{
  "id": "hanuman-chalisa",
  "title": "હનુમાન ચાલીસા",
  "lyrics": [
    {
      "type": "doha",
      "lines": [
        "શ્રી ગુરુ ચરણ સરોજ રજ નિજમન મુકુર સુધારિ ।",
        "વરણૌ રઘુવર વિમલયશ જો દાયક ફલચારિ ॥"
      ]
    },
    {
      "type": "doha",
      "lines": [
        "બુદ્ધિહીન તનુજાનિકૈ સુમિરૌ પવન કુમાર ।",
        "બલ બુદ્ધિ વિદ્યા દેહુ મોહિ હરહુ કલેશ વિકાર ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "જય હનુમાન જ્ઞાન ગુણ સાગર ।",
        "જય કપીશ તિહુ લોક ઉજાગર ॥ 1 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "રામદૂત અતુલિત બલધામા ।",
        "અંજનિ પુત્ર પવનસુત નામા ॥ 2 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "મહાવીર વિક્રમ બજરંગી ।",
        "કુમતિ નિવાર સુમતિ કે સંગી ॥ 3 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 4,
      "lines": [
        "કંચન વરણ વિરાજ સુવેશા ।",
        "કાનન કુંડલ કુંચિત કેશા ॥ 4 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 5,
      "lines": [
        "હાથવજ્ર ઔ ધ્વજા વિરાજૈ ।",
        "કાંથે મૂંજ જનેવૂ સાજૈ ॥ 5 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 6,
      "lines": [
        "શંકર સુવન કેસરી નંદન ।",
        "તેજ પ્રતાપ મહાજગ વંદન ॥ 6 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 7,
      "lines": [
        "વિદ્યાવાન ગુણી અતિ ચાતુર ।",
        "રામ કાજ કરિવે કો આતુર ॥ 7 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 8,
      "lines": [
        "પ્રભુ ચરિત્ર સુનિવે કો રસિયા ।",
        "રામલખન સીતા મન બસિયા ॥ 8 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 9,
      "lines": [
        "સૂક્ષ્મ રૂપધરિ સિયહિ દિખાવા ।",
        "વિકટ રૂપધરિ લંક જલાવા ॥ 9 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 10,
      "lines": [
        "ભીમ રૂપધરિ અસુર સંહારે ।",
        "રામચંદ્ર કે કાજ સંવારે ॥ 10 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 11,
      "lines": [
        "લાય સંજીવન લખન જિયાયે ।",
        "શ્રી રઘુવીર હરષિ ઉરલાયે ॥ 11 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 12,
      "lines": [
        "રઘુપતિ કીન્હી બહુત બડાયી ।",
        "તુમ મમ પ્રિય ભરત સમ ભાયી ॥ 12 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 13,
      "lines": [
        "સહસ્ર વદન તુમ્હરો યશગાવૈ ।",
        "અસ કહિ શ્રીપતિ કંઠ લગાવૈ ॥ 13 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 14,
      "lines": [
        "સનકાદિક બ્રહ્માદિ મુનીશા ।",
        "નારદ શારદ સહિત અહીશા ॥ 14 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 15,
      "lines": [
        "યમ કુબેર દિગપાલ જહાં તે ।",
        "કવિ કોવિદ કહિ સકે કહાં તે ॥ 15 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 16,
      "lines": [
        "તુમ ઉપકાર સુગ્રીવહિ કીન્હા ।",
        "રામ મિલાય રાજપદ દીન્હા ॥ 16 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 17,
      "lines": [
        "તુમ્હરો મંત્ર વિભીષણ માના ।",
        "લંકેશ્વર ભયે સબ જગ જાના ॥ 17 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 18,
      "lines": [
        "યુગ સહસ્ર યોજન પર ભાનૂ ।",
        "લીલ્યો તાહિ મધુર ફલ જાનૂ ॥ 18 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 19,
      "lines": [
        "પ્રભુ મુદ્રિકા મેલિ મુખ માહી ।",
        "જલધિ લાંઘિ ગયે અચરજ નાહી ॥ 19 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 20,
      "lines": [
        "દુર્ગમ કાજ જગત કે જેતે ।",
        "સુગમ અનુગ્રહ તુમ્હરે તેતે ॥ 20 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 21,
      "lines": [
        "રામ દુઆરે તુમ રખવારે ।",
        "હોત ન આજ્ઞા બિનુ પૈસારે ॥ 21 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 22,
      "lines": [
        "સબ સુખ લહૈ તુમ્હારી શરણા ।",
        "તુમ રક્ષક કાહૂ કો ડર ના ॥ 22 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 23,
      "lines": [
        "આપન તેજ સમ્હારો આપૈ ।",
        "તીનોં લોક હાંક તે કાંપૈ ॥ 23 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 24,
      "lines": [
        "ભૂત પિશાચ નિકટ નહિ આવૈ ।",
        "મહવીર જબ નામ સુનાવૈ ॥ 24 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 25,
      "lines": [
        "નાસૈ રોગ હરૈ સબ પીરા ।",
        "જપત નિરંતર હનુમત વીરા ॥ 25 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 26,
      "lines": [
        "સંકટ સે હનુમાન છુડાવૈ ।",
        "મન ક્રમ વચન ધ્યાન જો લાવૈ ॥ 26 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 27,
      "lines": [
        "સબ પર રામ તપસ્વી રાજા ।",
        "તિનકે કાજ સકલ તુમ સાજા ॥ 27 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 28,
      "lines": [
        "ઔર મનોરથ જો કોયિ લાવૈ ।",
        "તાસુ અમિત જીવન ફલ પાવૈ ॥ 28 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 29,
      "lines": [
        "ચારો યુગ પ્રતાપ તુમ્હારા ।",
        "હૈ પરસિદ્ધ જગત ઉજિયારા ॥ 29 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 30,
      "lines": [
        "સાધુ સંત કે તુમ રખવારે ।",
        "અસુર નિકંદન રામ દુલારે ॥ 30 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 31,
      "lines": [
        "અષ્ઠસિદ્ધિ નવ નિધિ કે દાતા ।",
        "અસ વર દીન્હ જાનકી માતા ॥ 31 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 32,
      "lines": [
        "રામ રસાયન તુમ્હારે પાસા ।",
        "સદા રહો રઘુપતિ કે દાસા ॥ 32 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 33,
      "lines": [
        "તુમ્હરે ભજન રામકો પાવૈ ।",
        "જન્મ જન્મ કે દુખ બિસરાવૈ ॥ 33 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 34,
      "lines": [
        "અંત કાલ રઘુપતિ પુરજાયી ।",
        "જહાં જન્મ હરિભક્ત કહાયી ॥ 34 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 35,
      "lines": [
        "ઔર દેવતા ચિત્ત ન ધરયી ।",
        "હનુમત સેયિ સર્વ સુખ કરયી ॥ 35 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 36,
      "lines": [
        "સંકટ કટૈ મિટૈ સબ પીરા ।",
        "જો સુમિરૈ હનુમત બલ વીરા ॥ 36 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 37,
      "lines": [
        "જૈ જૈ જૈ હનુમાન ગોસાયી ।",
        "કૃપા કરહુ ગુરુદેવ કી નાયી ॥ 37 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 38,
      "lines": [
        "યહ શત વાર પાઠ કર કોયી ।",
        "છૂટહિ બંદિ મહા સુખ હોયી ॥ 38 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 39,
      "lines": [
        "જો યહ પડૈ હનુમાન ચાલીસા ।",
        "હોય સિદ્ધિ સાખી ગૌરીશા ॥ 39 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 40,
      "lines": [
        "તુલસીદાસ સદા હરિ ચેરા ।",
        "કીજૈ નાથ હૃદય મહ ડેરા ॥ 40 ॥"
      ]
    },
    {
      "type": "doha",
      "lines": [
        "પવન તનય સંકટ હરણ - મંગળ મૂરતિ રૂપ્ ।",
        "રામ લખન સીતા સહિત - હૃદય બસહુ સુરભૂપ્ ॥"
      ]
    },
    {
      "type": "mangala",
      "lines": [
        "સિયાવર રામચંદ્રકી જય । પવનસુત હનુમાનકી જય । બોલો ભાયી સબ સંતનકી જય ।"
      ]
    }
  ]
}
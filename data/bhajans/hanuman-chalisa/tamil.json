{
  "id": "hanuman-chalisa",
  "title": "ஹனுமான் சாலீஸா",
  "lyrics": [
    {
      "type": "doha",
      "lines": [
        "ஶ்ரீ கு³ரு சரண ஸரோஜ ரஜ நிஜமன முகுர ஸுதா⁴ரி ।",
        "வரணௌ ரகு⁴வர விமலயஶ ஜோ தா³யக ப²லசாரி ॥"
      ]
    },
    {
      "type": "doha",
      "lines": [
        "பு³த்³தி⁴ஹீன தனுஜானிகை ஸுமிரௌ பவன குமார ।",
        "ப³ல பு³த்³தி⁴ வித்³யா தே³ஹு மோஹி ஹரஹு கலேஶ விகார ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "ஜய ஹனுமான ஜ்ஞான கு³ண ஸாக³ர ।",
        "ஜய கபீஶ திஹு லோக உஜாக³ர ॥ 1 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "ராமதூ³த அதுலித ப³லதா⁴மா ।",
        "அஞ்ஜனி புத்ர பவனஸுத நாமா ॥ 2 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "மஹாவீர விக்ரம பஜ³ரங்கீ³ ।",
        "குமதி நிவார ஸுமதி கே ஸங்கீ³ ॥ 3 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 4,
      "lines": [
        "கஞ்சன வரண விராஜ ஸுவேஶா ।",
        "கானன குண்ட³ல குஞ்சித கேஶா ॥ 4 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 5,
      "lines": [
        "ஹாத²வஜ்ர ஔ த்⁴வஜா விராஜை ।",
        "காந்தே² மூஞ்ஜ ஜனேவூ ஸாஜை ॥ 5 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 6,
      "lines": [
        "ஶங்கர ஸுவன கேஸரீ நந்த³ன ।",
        "தேஜ ப்ரதாப மஹாஜக³ வந்த³ன ॥ 6 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 7,
      "lines": [
        "வித்³யாவான கு³ணீ அதி சாதுர ।",
        "ராம காஜ கரிவே கோ ஆதுர ॥ 7 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 8,
      "lines": [
        "ப்ரபு⁴ சரித்ர ஸுனிவே கோ ரஸியா ।",
        "ராமலக²ன ஸீதா மன ப³ஸியா ॥ 8 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 9,
      "lines": [
        "ஸூக்ஷ்ம ரூபத⁴ரி ஸியஹி தி³கா²வா ।",
        "விகட ரூபத⁴ரி லங்க ஜலாவா ॥ 9 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 10,
      "lines": [
        "பீ⁴ம ரூபத⁴ரி அஸுர ஸம்ஹாரே ।",
        "ராமசந்த்³ர கே காஜ ஸம்வாரே ॥ 10 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 11,
      "lines": [
        "லாய ஸஞ்ஜீவன லக²ன ஜியாயே ।",
        "ஶ்ரீ ரகு⁴வீர ஹரஷி உரலாயே ॥ 11 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 12,
      "lines": [
        "ரகு⁴பதி கீன்ஹீ ப³ஹுத ப³டா³யீ ।",
        "தும மம ப்ரிய ப⁴ரத ஸம பா⁴யீ ॥ 12 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 13,
      "lines": [
        "ஸஹஸ்ர வத³ன தும்ஹரோ யஶகா³வை ।",
        "அஸ கஹி ஶ்ரீபதி கண்ட² லகா³வை ॥ 13 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 14,
      "lines": [
        "ஸனகாதி³க ப்³ரஹ்மாதி³ முனீஶா ।",
        "நாரத³ ஶாரத³ ஸஹித அஹீஶா ॥ 14 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 15,
      "lines": [
        "யம குபே³ர தி³க³பால ஜஹாம் தே ।",
        "கவி கோவித³ கஹி ஸகே கஹாம் தே ॥ 15 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 16,
      "lines": [
        "தும உபகார ஸுக்³ரீவஹி கீன்ஹா ।",
        "ராம மிலாய ராஜபத³ தீ³ன்ஹா ॥ 16 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 17,
      "lines": [
        "தும்ஹரோ மந்த்ர விபீ⁴ஷண மானா ।",
        "லங்கேஶ்வர ப⁴யே ஸப³ ஜக³ ஜானா ॥ 17 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 18,
      "lines": [
        "யுக³ ஸஹஸ்ர யோஜன பர பா⁴னூ ।",
        "லீல்யோ தாஹி மது⁴ர ப²ல ஜானூ ॥ 18 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 19,
      "lines": [
        "ப்ரபு⁴ முத்³ரிகா மேலி முக² மாஹீ ।",
        "ஜலதி⁴ லாங்கி⁴ க³யே அசரஜ நாஹீ ॥ 19 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 20,
      "lines": [
        "து³ர்க³ம காஜ ஜக³த கே ஜேதே ।",
        "ஸுக³ம அனுக்³ரஹ தும்ஹரே தேதே ॥ 20 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 21,
      "lines": [
        "ராம து³ஆரே தும ரக²வாரே ।",
        "ஹோத ந ஆஜ்ஞா பி³னு பைஸாரே ॥ 21 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 22,
      "lines": [
        "ஸப³ ஸுக² லஹை தும்ஹாரீ ஶரணா ।",
        "தும ரக்ஷக காஹூ கோ ட³ர நா ॥ 22 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 23,
      "lines": [
        "ஆபன தேஜ ஸம்ஹாரோ ஆபை ।",
        "தீனோம் லோக ஹாங்க தே காம்பை ॥ 23 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 24,
      "lines": [
        "பூ⁴த பிஶாச நிகட நஹி ஆவை ।",
        "மஹவீர ஜப³ நாம ஸுனாவை ॥ 24 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 25,
      "lines": [
        "நாஸை ரோக³ ஹரை ஸப³ பீரா ।",
        "ஜபத நிரந்தர ஹனுமத வீரா ॥ 25 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 26,
      "lines": [
        "ஸங்கட ஸே ஹனுமான சு²டா³வை ।",
        "மன க்ரம வசன த்⁴யான ஜோ லாவை ॥ 26 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 27,
      "lines": [
        "ஸப³ பர ராம தபஸ்வீ ராஜா ।",
        "தினகே காஜ ஸகல தும ஸாஜா ॥ 27 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 28,
      "lines": [
        "ஔர மனோரத² ஜோ கோயி லாவை ।",
        "தாஸு அமித ஜீவன ப²ல பாவை ॥ 28 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 29,
      "lines": [
        "சாரோ யுக³ ப்ரதாப தும்ஹாரா ।",
        "ஹை பரஸித்³த⁴ ஜக³த உஜியாரா ॥ 29 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 30,
      "lines": [
        "ஸாது⁴ ஸந்த கே தும ரக²வாரே ।",
        "அஸுர நிகந்த³ன ராம து³லாரே ॥ 30 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 31,
      "lines": [
        "அஷ்ட²ஸித்³தி⁴ நவ நிதி⁴ கே தா³தா ।",
        "அஸ வர தீ³ன்ஹ ஜானகீ மாதா ॥ 31 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 32,
      "lines": [
        "ராம ரஸாயன தும்ஹாரே பாஸா ।",
        "ஸதா³ ரஹோ ரகு⁴பதி கே தா³ஸா ॥ 32 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 33,
      "lines": [
        "தும்ஹரே பஜ⁴ன ராமகோ பாவை ।",
        "ஜன்ம ஜன்ம கே து³க² பி³ஸராவை ॥ 33 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 34,
      "lines": [
        "அந்த கால ரகு⁴பதி புரஜாயீ ।",
        "ஜஹாம் ஜன்ம ஹரிப⁴க்த கஹாயீ ॥ 34 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 35,
      "lines": [
        "ஔர தே³வதா சித்த ந த⁴ரயீ ।",
        "ஹனுமத ஸேயி ஸர்வ ஸுக² கரயீ ॥ 35 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 36,
      "lines": [
        "ஸங்கட கடை மிடை ஸப³ பீரா ।",
        "ஜோ ஸுமிரை ஹனுமத ப³ல வீரா ॥ 36 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 37,
      "lines": [
        "ஜை ஜை ஜை ஹனுமான கோ³ஸாயீ ।",
        "க்ருபா கரஹு கு³ருதே³வ கீ நாயீ ॥ 37 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 38,
      "lines": [
        "யஹ ஶத வார பாட² கர கோயீ ।",
        "சூ²டஹி ப³ந்தி³ மஹா ஸுக² ஹோயீ ॥ 38 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 39,
      "lines": [
        "ஜோ யஹ படை³ ஹனுமான சாலீஸா ।",
        "ஹோய ஸித்³தி⁴ ஸாகீ² கௌ³ரீஶா ॥ 39 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 40,
      "lines": [
        "துலஸீதா³ஸ ஸதா³ ஹரி சேரா ।",
        "கீஜை நாத² ஹ்ருத³ய மஹ டே³ரா ॥ 40 ॥"
      ]
    },
    {
      "type": "doha",
      "lines": [
        "பவன தனய ஸங்கட ஹரண - மங்கள³ மூரதி ரூப் ।",
        "ராம லக²ன ஸீதா ஸஹித - ஹ்ருத³ய ப³ஸஹு ஸுரபூ⁴ப் ॥"
      ]
    },
    {
      "type": "mangala",
      "lines": [
        "ஸியாவர ராமசந்த்³ரகீ ஜய । பவனஸுத ஹனுமானகீ ஜய । போ³லோ பா⁴யீ ஸப³ ஸந்தனகீ ஜய ।"
      ]
    }
  ]
}
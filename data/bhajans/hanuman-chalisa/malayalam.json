{
  "id": "hanuman-chalisa",
  "title": "ഹനുമാൻ ചാലീസാ",
  "lyrics": [
    {
      "type": "doha",
      "lines": [
        "ശ്രീ ഗുരു ചരണ സരോജ രജ നിജമന മുകുര സുധാരി ।",
        "വരണൌ രഘുവര വിമലയശ ജോ ദായക ഫലചാരി ॥"
      ]
    },
    {
      "type": "doha",
      "lines": [
        "ബുദ്ധിഹീന തനുജാനികൈ സുമിരൌ പവന കുമാര ।",
        "ബല ബുദ്ധി വിദ്യാ ദേഹു മോഹി ഹരഹു കലേശ വികാര ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "ജയ ഹനുമാന ജ്ഞാന ഗുണ സാഗര ।",
        "ജയ കപീശ തിഹു ലോക ഉജാഗര ॥ 1 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "രാമദൂത അതുലിത ബലധാമാ ।",
        "അംജനി പുത്ര പവനസുത നാമാ ॥ 2 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "മഹാവീര വിക്രമ ബജരംഗീ ।",
        "കുമതി നിവാര സുമതി കേ സംഗീ ॥ 3 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 4,
      "lines": [
        "കംചന വരണ വിരാജ സുവേശാ ।",
        "കാനന കുംഡല കുംചിത കേശാ ॥ 4 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 5,
      "lines": [
        "ഹാഥവജ്ര ഔ ധ്വജാ വിരാജൈ ।",
        "കാംഥേ മൂംജ ജനേവൂ സാജൈ ॥ 5 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 6,
      "lines": [
        "ശംകര സുവന കേസരീ നംദന ।",
        "തേജ പ്രതാപ മഹാജഗ വംദന ॥ 6 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 7,
      "lines": [
        "വിദ്യാവാന ഗുണീ അതി ചാതുര ।",
        "രാമ കാജ കരിവേ കോ ആതുര ॥ 7 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 8,
      "lines": [
        "പ്രഭു ചരിത്ര സുനിവേ കോ രസിയാ ।",
        "രാമലഖന സീതാ മന ബസിയാ ॥ 8 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 9,
      "lines": [
        "സൂക്ഷ്മ രൂപധരി സിയഹി ദിഖാവാ ।",
        "വികട രൂപധരി ലംക ജലാവാ ॥ 9 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 10,
      "lines": [
        "ഭീമ രൂപധരി അസുര സംഹാരേ ।",
        "രാമചംദ്ര കേ കാജ സംവാരേ ॥ 10 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 11,
      "lines": [
        "ലായ സംജീവന ലഖന ജിയായേ ।",
        "ശ്രീ രഘുവീര ഹരഷി ഉരലായേ ॥ 11 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 12,
      "lines": [
        "രഘുപതി കീന്‍ഹീ ബഹുത ബഡായീ ।",
        "തുമ മമ പ്രിയ ഭരത സമ ഭായീ ॥ 12 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 13,
      "lines": [
        "സഹസ്ര വദന തുമ്‍ഹരോ യശഗാവൈ ।",
        "അസ കഹി ശ്രീപതി കംഠ ലഗാവൈ ॥ 13 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 14,
      "lines": [
        "സനകാദിക ബ്രഹ്മാദി മുനീശാ ।",
        "നാരദ ശാരദ സഹിത അഹീശാ ॥ 14 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 15,
      "lines": [
        "യമ കുബേര ദിഗപാല ജഹാം തേ ।",
        "കവി കോവിദ കഹി സകേ കഹാം തേ ॥ 15 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 16,
      "lines": [
        "തുമ ഉപകാര സുഗ്രീവഹി കീന്‍ഹാ ।",
        "രാമ മിലായ രാജപദ ദീന്‍ഹാ ॥ 16 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 17,
      "lines": [
        "തുമ്‍ഹരോ മംത്ര വിഭീഷണ മാനാ ।",
        "ലംകേശ്വര ഭയേ സബ ജഗ ജാനാ ॥ 17 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 18,
      "lines": [
        "യുഗ സഹസ്ര യോജന പര ഭാനൂ ।",
        "ലീല്‍യോ താഹി മധുര ഫല ജാനൂ ॥ 18 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 19,
      "lines": [
        "പ്രഭു മുദ്രികാ മേലി മുഖ മാഹീ ।",
        "ജലധി ലാംഘി ഗയേ അചരജ നാഹീ ॥ 19 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 20,
      "lines": [
        "ദുര്‍ഗമ കാജ ജഗത കേ ജേതേ ।",
        "സുഗമ അനുഗ്രഹ തുമ്‍ഹരേ തേതേ ॥ 20 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 21,
      "lines": [
        "രാമ ദുആരേ തുമ രഖവാരേ ।",
        "ഹോത ന ആജ്ഞാ ബിനു പൈസാരേ ॥ 21 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 22,
      "lines": [
        "സബ സുഖ ലഹൈ തുമ്‍ഹാരീ ശരണാ ।",
        "തുമ രക്ഷക കാഹൂ കോ ഡര നാ ॥ 22 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 23,
      "lines": [
        "ആപന തേജ സമ്‍ഹാരോ ആപൈ ।",
        "തീനോം ലോക ഹാംക തേ കാംപൈ ॥ 23 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 24,
      "lines": [
        "ഭൂത പിശാച നികട നഹി ആവൈ ।",
        "മഹവീര ജബ നാമ സുനാവൈ ॥ 24 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 25,
      "lines": [
        "നാസൈ രോഗ ഹരൈ സബ പീരാ ।",
        "ജപത നിരംതര ഹനുമത വീരാ ॥ 25 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 26,
      "lines": [
        "സംകട സേ ഹനുമാന ഛുഡാവൈ ।",
        "മന ക്രമ വചന ധ്യാന ജോ ലാവൈ ॥ 26 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 27,
      "lines": [
        "സബ പര രാമ തപസ്വീ രാജാ ।",
        "തിനകേ കാജ സകല തുമ സാജാ ॥ 27 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 28,
      "lines": [
        "ഔര മനോരഥ ജോ കോയി ലാവൈ ।",
        "താസു അമിത ജീവന ഫല പാവൈ ॥ 28 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 29,
      "lines": [
        "ചാരോ യുഗ പ്രതാപ തുമ്‍ഹാരാ ।",
        "ഹൈ പരസിദ്ധ ജഗത ഉജിയാരാ ॥ 29 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 30,
      "lines": [
        "സാധു സംത കേ തുമ രഖവാരേ ।",
        "അസുര നികംദന രാമ ദുലാരേ ॥ 30 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 31,
      "lines": [
        "അഷ്ഠസിദ്ധി നവ നിധി കേ ദാതാ ।",
        "അസ വര ദീന്‍ഹ ജാനകീ മാതാ ॥ 31 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 32,
      "lines": [
        "രാമ രസായന തുമ്‍ഹാരേ പാസാ ।",
        "സദാ രഹോ രഘുപതി കേ ദാസാ ॥ 32 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 33,
      "lines": [
        "തുമ്‍ഹരേ ഭജന രാമകോ പാവൈ ।",
        "ജന്‍മ ജന്‍മ കേ ദുഖ ബിസരാവൈ ॥ 33 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 34,
      "lines": [
        "അംത കാല രഘുപതി പുരജായീ ।",
        "ജഹാം ജന്‍മ ഹരിഭക്ത കഹായീ ॥ 34 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 35,
      "lines": [
        "ഔര ദേവതാ ചിത്ത ന ധരയീ ।",
        "ഹനുമത സേയി സർവ സുഖ കരയീ ॥ 35 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 36,
      "lines": [
        "സംകട കടൈ മിടൈ സബ പീരാ ।",
        "ജോ സുമിരൈ ഹനുമത ബല വീരാ ॥ 36 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 37,
      "lines": [
        "ജൈ ജൈ ജൈ ഹനുമാന ഗോസായീ ।",
        "കൃപാ കരഹു ഗുരുദേവ കീ നായീ ॥ 37 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 38,
      "lines": [
        "യഹ ശത വാര പാഠ കര കോയീ ।",
        "ഛൂടഹി ബംദി മഹാ സുഖ ഹോയീ ॥ 38 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 39,
      "lines": [
        "ജോ യഹ പഡൈ ഹനുമാന ചാലീസാ ।",
        "ഹോയ സിദ്ധി സാഖീ ഗൌരീശാ ॥ 39 ॥"
      ]
    },
    {
      "type": "chaupai",
      "number": 40,
      "lines": [
        "തുലസീദാസ സദാ ഹരി ചേരാ ।",
        "കീജൈ നാഥ ഹൃദയ മഹ ഡേരാ ॥ 40 ॥"
      ]
    },
    {
      "type": "doha",
      "lines": [
        "പവന തനയ സംകട ഹരണ - മംഗള മൂരതി രൂപ് ।",
        "രാമ ലഖന സീതാ സഹിത - ഹൃദയ ബസഹു സുരഭൂപ് ॥"
      ]
    },
    {
      "type": "mangala",
      "lines": [
        "സിയാവര രാമചംദ്രകീ ജയ । പവനസുത ഹനുമാനകീ ജയ । ബോലോ ഭായീ സബ സംതനകീ ജയ ।"
      ]
    }
  ]
}
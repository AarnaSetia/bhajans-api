{
  "id": "nammamma-sharade-uma-maheshwari",
  "title": "ನಮ್ಮಮ್ಮ ಶಾರದೆ ಉಮಾ ಮಹೇಶ್ವರಿ",
  "lyrics": [
    {
      "type": "dhyanam",
      "lines": [
        "ನಮ್ಮಮ್ಮ ಶಾರದೆ ಉಮಾ ಮಹೇಶ್ವರಿ",
        "ನಿಮ್ಮೊಳಗಿಹನ್ಯಾರಮ್ಮ",
        "ಕಮ್ಮಗೋಲನ ವೈರಿ ಸುತನಾದ ಸೊಂಡಿಲ",
        "ಹೆಮ್ಮೆಯ ಗಣನಾಥನೆ ಅಮ್ಮಯಾ"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "ಮೋರೆ ಕಪ್ಪಿನ ಭಾವ ಮರೆದಗಲ ಕಿವಿ",
        "ಕೋರೆದಾಡೆಯವನ್ಯಾರಮ್ಮ",
        "ಕೋರೆದಾಡೆಯವನ್ಯಾರಮ್ಮ",
        "ಮೂರು ಕಣ್ಣನ ಸುತ ಮುರಿದಿಟ್ಟ ಚಂದ್ರನ",
        "ಧೀರ ಗಣನಾಥನೆ ಅಮ್ಮಯಾ"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "ಉಟ್ಟ ದಟ್ಟಿಯು ಬಿಗಿದುಟ್ಟ ಚೆಲ್ಲಣದ",
        "ದಿಟ್ಟತಾನಿವನ್ಯಾರಮ್ಮ",
        "ದಿಟ್ಟತಾನಿವನ್ಯಾರಮ್ಮ",
        "ಶಿವನ ಪಟ್ಟದ ರಾಣಿ ಪಾರ್ವತಿಯ ಕುಮಾರು",
        "ಹೊಟ್ಟೆಯ ಗಣನಾಥನೆ ಅಮ್ಮಯಾ"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "ರಾಶಿ ವಿದ್ಯೆಯ ಬಲ್ಲ ರಮಣಿ ಹಂಬಲನೊಲ್ಲ",
        "ಭಾಷಿಗನಿವನ್ಯಾರಮ್ಮ",
        "ಭಾಷಿಗನಿವನ್ಯಾರಮ್ಮ",
        "ಲೇಸಾಗಿ ಜನರ ಸಲಹುವ ನೆಲೆಯಾದಿ",
        "ಕೇಶವ ದಾಸ ಕಾಣೆ ಅಮ್ಮಯಾ"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "ನಮ್ಮಮ್ಮ ಶಾರದೆ ಉಮಾ ಮಹೇಶ್ವರಿ",
        "ನಿಮ್ಮೊಳಗಿಹನ್ಯಾರಮ್ಮ",
        "ಕಮ್ಮಗೋಲನ ವೈರಿ ಸುತನಾದ ಸೊಂಡಿಲ",
        "ಹೆಮ್ಮೆಯ ಗಣನಾಥನೆ ಅಮ್ಮಯಾ"
      ]
    }
  ]
}

{
  "id": "kabhi-ram-banke-kabhi-shyam-banke",
  "title": "कभी राम बनके कभी श्याम बनके",
  "lyrics": [
    {
      "type": "verse",
      "lines": [
        "कभी राम बनके कभी श्याम बनके",
        "चले आना प्रभुजी चले आना"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "तुम राम रूप में आना",
        "तुम राम रूप में आना",
        "सीता साथ लेके, धनुष हाथ लेके",
        "चले आना प्रभुजी चले आना"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "तुम श्याम रूप में आना",
        "तुम श्याम रूप में आना",
        "राधा साथ लेके, मुरली हाथ लेके",
        "चले आना प्रभुजी चले आना"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "तुम शिव के रूप में आना",
        "तुम शिव के रूप में आना",
        "गौरा साथ लेके, डमरू हाथ लेके",
        "चले आना प्रभुजी चले आना"
      ]
    },
    {
      "type": "chaupai",
      "number": 4,
      "lines": [
        "तुम विष्णु रूप में आना",
        "तुम विष्णु रूप में आना",
        "लक्ष्मी साथ लेके, चक्र हाथ लेके",
        "चले आना प्रभुजी चले आना"
      ]
    },
    {
      "type": "chaupai",
      "number": 5,
      "lines": [
        "तुम गणपति रूप में आना",
        "तुम गणपति रूप में आना",
        "रिद्धि साथ लेके, सिद्धि साथ लेके",
        "चले आना प्रभुजी चले आना"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "कभी राम बनके कभी श्याम बनके",
        "चले आना प्रभुजी चले आना",
        "कभी राम बनके कभी श्याम बनके",
        "चले आना प्रभुजी चले आना"
      ]
    }
  ]
}

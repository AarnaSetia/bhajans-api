{
  "id": "abir-gulaal-udhalit-rang",
  "title": "अबीर गुलाल उधळीत रंग",
  "lyrics": [
    {
      "type": "verse",
      "lines": [
        "अबीर गुलाल उधळीत रंग",
        "नाथा घरी नाचे माझा सखा पांडुरंग"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "उंबरठ्यासी कैसे शिवू आम्ह जाती हीन",
        "रूप तुझे कैसे पाहू त्यात आम्ह लीन",
        "पायरीशी होऊ दंग गाऊनी अभंग"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "वाळवंटी गाऊ आम्ह वाळवंटी नाचू",
        "चंद्रभागेच्या पाण्याने अंग अंग न्हाऊ",
        "विठ्ठलाचे नाम घेऊ होउनी निःसंग"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "आषाढी कार्तिकी भक्तजन येती",
        "पंढरीच्या वाळवंटी संत गोळा होती",
        "चोखा म्हणे नाम घेता भक्त होती दंग"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "अबीर गुलाल उधळीत रंग",
        "नाथा घरी नाचे माझा सखा पांडुरंग",
        "नाथा घरी नाचे",
        "नाथाSS घरी नाचे माझा",
        "सखा पांडुरंग",
        "अबीर गुलाल",
        "अबीर गुलाल",
        "अबीरSSSS"
      ]
    }
  ]
}

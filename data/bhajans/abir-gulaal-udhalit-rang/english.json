{
  "id": "abir-gulaal-udhalit-rang",
  "title": "Abir Gulaal Udhalit Rang",
  "lyrics": [
    {
      "type": "verse",
      "lines": [
        "Abir gulaal udhalit rang",
        "Naatha ghari naache maajha sakha Paandurng"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "Unbarathhyaasi kaise shiwu amhi jaati hin",
        "Rup tujhe kaise paahu tyaat amhi lin",
        "Paayarishi hou dang gaauni abhang"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "Waalawnti gaau amhi waalawnti naachu",
        "Chndrabhaagechya paanyaane ang-ang nhaau",
        "Withhthhalaache naam gheu houni nihsang"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "Ashaadhi kaartiki bhaktajan yeti",
        "Pndharichya waalawnti sant gola hoti",
        "Chokha mhane naam gheta bhakt hoti dang"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Abir gulaal udhalit rang",
        "Naatha ghari naache maajha sakha Paandurng",
        "Naatha ghari naache",
        "NaathaSS ghari naache maajha sakha Paandurng",
        "Abir gulaal",
        "Abir gulaal",
        "AbirSSSS"
      ]
    }
  ]
}

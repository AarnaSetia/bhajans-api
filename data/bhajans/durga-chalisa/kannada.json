{
  "id": "durga-chalisa",
  "title": "ದುರ್ಗಾ ಚಾಲೀಸಾ",
  "lyrics": [
    {"type": "chaupai", "number": 1, "lines": ["ನಮೋ ನಮೋ ದುರ್ಗೇ ಸುಖ ಕರನೀ ।", "ನಮೋ ನಮೋ ಅಂಬೇ ದುಃಖ ಹರನೀ ॥ 1 ॥"]},
    {"type": "chaupai", "number": 2, "lines": ["ನಿರಂಕಾರ ಹೈ ಜ್ಯೋತಿ ತುಮ್ಹಾರೀ ।", "ತಿಹೂ ಲೋಕ ಫೈಲೀ ಉಜಿಯಾರೀ ॥ 2 ॥"]},
    {"type": "chaupai", "number": 3, "lines": ["ಶಶಿ ಲಲಾಟ ಮುಖ ಮಹಾವಿಶಾಲಾ ।", "ನೇತ್ರ ಲಾಲ ಭೃಕುಟಿ ವಿಕರಾಲಾ ॥ 3 ॥"]},
    {"type": "chaupai", "number": 4, "lines": ["ರೂಪ ಮಾತು ಕೋ ಅಧಿಕ ಸುಹಾವೇ ।", "ದರಶ ಕರತ ಜನ ಅತಿ ಸುಖ ಪಾವೇ ॥ 4 ॥"]},
    {"type": "chaupai", "number": 5, "lines": ["ತುಮ ಸಂಸಾರ ಶಕ್ತಿ ಲಯ ಕೀನಾ ।", "ಪಾಲನ ಹೇತು ಅನ್ನ ಧನ ದೀನಾ ॥ 5 ॥"]},
    {"type": "chaupai", "number": 6, "lines": ["ಅನ್ನಪೂರ್ಣಾ ಹುಯಿ ಜಗ ಪಾಲಾ ।", "ತುಮ ಹೀ ಆದಿ ಸುಂದರೀ ಬಾಲಾ ॥ 6 ॥"]},
    {"type": "chaupai", "number": 7, "lines": ["ಪ್ರಲಯಕಾಲ ಸಬ ನಾಶನ ಹಾರೀ ।", "ತುಮ ಗೌರೀ ಶಿವ ಶಂಕರ ಪ್ಯಾರೀ ॥ 7 ॥"]},
    {"type": "chaupai", "number": 8, "lines": ["ಶಿವ ಯೋಗೀ ತುಮ್ಹರೇ ಗುಣ ಗಾವೇಮ್ ।", "ಬ್ರಹ್ಮಾ ವಿಷ್ಣು ತುಮ್ಹೇಂ ನಿತ ಧ್ಯಾವೇಮ್ ॥ 8 ॥"]},
    {"type": "chaupai", "number": 9, "lines": ["ರೂಪ ಸರಸ್ವತೀ ಕಾ ತುಮ ಧಾರಾ ।", "ದೇ ಸುಬುದ್ಧಿ ಋಷಿ ಮುನಿನ ಉಬಾರಾ ॥ 9 ॥"]},
    {"type": "chaupai", "number": 10, "lines": ["ಧರಾ ರೂಪ ನರಸಿಂಹ ಕೋ ಅಂಬಾ ।", "ಪರಗಟ ಭಯಿ ಫಾಡ ಕೇ ಖಂಬಾ ॥ 10 ॥"]},
    {"type": "chaupai", "number": 11, "lines": ["ರಕ್ಷಾ ಕರ ಪ್ರಹ್ಲಾದ ಬಚಾಯೋ ।", "ಹಿರಣ್ಯಾಕ್ಷ ಕೋ ಸ್ವರ್ಗ ಪಠಾಯೋ ॥ 11 ॥"]},
    {"type": "chaupai", "number": 12, "lines": ["ಲಕ್ಷ್ಮೀ ರೂಪ ಧರೋ ಜಗ ಮಾಹೀಮ್ ।", "ಶ್ರೀ ನಾರಾಯಣ ಅಂಗ ಸಮಾಹೀಮ್ ॥ 12 ॥"]},
    {"type": "chaupai", "number": 13, "lines": ["ಕ್ಷೀರಸಿಂಧು ಮೇಂ ಕರತ ವಿಲಾಸಾ ।", "ದಯಾಸಿಂಧು ದೀಜೈ ಮನ ಆಸಾ ॥ 13 ॥"]},
    {"type": "chaupai", "number": 14, "lines": ["ಹಿಂಗಲಾಜ ಮೇಂ ತುಮ್ಹೀಂ ಭವಾನೀ ।", "ಮಹಿಮಾ ಅಮಿತ ನ ಜಾತ ಬಖಾನೀ ॥ 14 ॥"]},
    {"type": "chaupai", "number": 15, "lines": ["ಮಾತಂಗೀ ಧೂಮಾವತಿ ಮಾತಾ ।", "ಭುವನೇಶ್ವರೀ ಬಗಲಾ ಸುಖದಾತಾ ॥ 15 ॥"]},
    {"type": "chaupai", "number": 16, "lines": ["ಶ್ರೀ ಭೈರವ ತಾರಾ ಜಗ ತಾರಿಣೀ ।", "ಛಿನ್ನ ಭಾಲ ಭವ ದುಃಖ ನಿವಾರಿಣೀ ॥ 16 ॥"]},
    {"type": "chaupai", "number": 17, "lines": ["ಕೇಹರಿ ವಾಹನ ಸೋಹ ಭವಾನೀ ।", "ಲಾಂಗುರ ವೀರ ಚಲತ ಅಗವಾನೀ ॥ 17 ॥"]},
    {"type": "chaupai", "number": 18, "lines": ["ಕರ ಮೇಂ ಖಪ್ಪರ ಖಡಗ ವಿರಾಜೇ ।", "ಜಾಕೋ ದೇಖ ಕಾಲ ಡರ ಭಾಜೇ ॥ 18 ॥"]},
    {"type": "chaupai", "number": 19, "lines": ["ತೋಹೇ ಕರ ಮೇಂ ಅಸ್ತ್ರ ತ್ರಿಶೂಲಾ ।", "ಜಾತೇ ಉಠತ ಶತ್ರು ಹಿಯ ಶೂಲಾ ॥ 19 ॥"]},
    {"type": "chaupai", "number": 20, "lines": ["ನಗರಕೋಟಿ ಮೇಂ ತುಮ್ಹೀಂ ವಿರಾಜತ ।", "ತಿಹುಁ ಲೋಕ ಮೇಂ ಡಂಕಾ ಬಾಜತ ॥ 20 ॥"]},
    {"type": "chaupai", "number": 21, "lines": ["ಶುಂಭ ನಿಶುಂಭ ದಾನವ ತುಮ ಮಾರೇ ।", "ರಕ್ತಬೀಜ ಶಂಖನ ಸಂಹಾರೇ ॥ 21 ॥"]},
    {"type": "chaupai", "number": 22, "lines": ["ಮಹಿಷಾಸುರ ನೃಪ ಅತಿ ಅಭಿಮಾನೀ ।", "ಜೇಹಿ ಅಘ ಭಾರ ಮಹೀ ಅಕುಲಾನೀ ॥ 22 ॥"]},
    {"type": "chaupai", "number": 23, "lines": ["ರೂಪ ಕರಾಲ ಕಾಲಿಕಾ ಧಾರಾ ।", "ಸೇನ ಸಹಿತ ತುಮ ತಿಹಿ ಸಂಹಾರಾ ॥ 23 ॥"]},
    {"type": "chaupai", "number": 24, "lines": ["ಪಡೀ ಭೀಢ ಸಂತನ ಪರ ಜಬ ಜಬ ।", "ಭಯಿ ಸಹಾಯ ಮಾತು ತುಮ ತಬ ತಬ ॥ 24 ॥"]},
    {"type": "chaupai", "number": 25, "lines": ["ಅಮರಪುರೀ ಅರು ಬಾಸವ ಲೋಕಾ ।", "ತಬ ಮಹಿಮಾ ಸಬ ಕಹೇಂ ಅಶೋಕಾ ॥ 25 ॥"]},
    {"type": "chaupai", "number": 26, "lines": ["ಜ್ವಾಲಾ ಮೇಂ ಹೈ ಜ್ಯೋತಿ ತುಮ್ಹಾರೀ ।", "ತುಮ್ಹೇಂ ಸದಾ ಪೂಜೇಂ ನರ ನಾರೀ ॥ 26 ॥"]},
    {"type": "chaupai", "number": 27, "lines": ["ಪ್ರೇಮ ಭಕ್ತಿ ಸೇ ಜೋ ಯಶ ಗಾವೇಮ್ ।", "ದುಃಖ ದಾರಿದ್ರ ನಿಕಟ ನಹಿಂ ಆವೇಮ್ ॥ 27 ॥"]},
    {"type": "chaupai", "number": 28, "lines": ["ಧ್ಯಾವೇ ತುಮ್ಹೇಂ ಜೋ ನರ ಮನ ಲಾಯಿ ।", "ಜನ್ಮ ಮರಣ ತೇ ಸೌಂ ಛುಟ ಜಾಯಿ ॥ 28 ॥"]},
    {"type": "chaupai", "number": 29, "lines": ["ಜೋಗೀ ಸುರ ಮುನಿ ಕಹತ ಪುಕಾರೀ ।", "ಯೋಗ ನ ಹೋಯಿ ಬಿನ ಶಕ್ತಿ ತುಮ್ಹಾರೀ ॥ 29 ॥"]},
    {"type": "chaupai", "number": 30, "lines": ["ಶಂಕರ ಆಚಾರಜ ತಪ ಕೀನೋ ।", "ಕಾಮ ಅರು ಕ್ರೋಧ ಜೀತ ಸಬ ಲೀನೋ ॥ 30 ॥"]},
    {"type": "chaupai", "number": 31, "lines": ["ನಿಶಿದಿನ ಧ್ಯಾನ ಧರೋ ಶಂಕರ ಕೋ ।", "ಕಾಹು ಕಾಲ ನಹಿಂ ಸುಮಿರೋ ತುಮಕೋ ॥ 31 ॥"]},
    {"type": "chaupai", "number": 32, "lines": ["ಶಕ್ತಿ ರೂಪ ಕೋ ಮರಮ ನ ಪಾಯೋ ।", "ಶಕ್ತಿ ಗಯೀ ತಬ ಮನ ಪಛತಾಯೋ ॥ 32 ॥"]},
    {"type": "chaupai", "number": 33, "lines": ["ಶರಣಾಗತ ಹುಯಿ ಕೀರ್ತಿ ಬಖಾನೀ ।", "ಜಯ ಜಯ ಜಯ ಜಗದಂಬ ಭವಾನೀ ॥ 33 ॥"]},
    {"type": "chaupai", "number": 34, "lines": ["ಭಯಿ ಪ್ರಸನ್ನ ಆದಿ ಜಗದಂಬಾ ।", "ದಯಿ ಶಕ್ತಿ ನಹಿಂ ಕೀನ ವಿಲಂಬಾ ॥ 34 ॥"]},
    {"type": "chaupai", "number": 35, "lines": ["ಮೋಕೋ ಮಾತು ಕಷ್ಟ ಅತಿ ಘೇರೋ ।", "ತುಮ ಬಿನ ಕೌನ ಹರೈ ದುಃಖ ಮೇರೋ ॥ 35 ॥"]},
    {"type": "chaupai", "number": 36, "lines": ["ಆಶಾ ತೃಷ್ಣಾ ನಿಪಟ ಸತಾವೇಮ್ ।", "ರಿಪು ಮೂರಖ ಮೊಹಿ ಅತಿ ದರ ಪಾವೈಮ್ ॥ 36 ॥"]},
    {"type": "chaupai", "number": 37, "lines": ["ಶತ್ರು ನಾಶ ಕೀಜೈ ಮಹಾರಾನೀ ।", "ಸುಮಿರೌಂ ಇಕಚಿತ ತುಮ್ಹೇಂ ಭವಾನೀ ॥ 37 ॥"]},
    {"type": "chaupai", "number": 38, "lines": ["ಕರೋ ಕೃಪಾ ಹೇ ಮಾತು ದಯಾಲಾ ।", "ಋದ್ಧಿ-ಸಿದ್ಧಿ ದೇ ಕರಹು ನಿಹಾಲಾ ॥ 38 ॥"]},
    {"type": "chaupai", "number": 39, "lines": ["ಜಬ ಲಗಿ ಜಿಯೂ ದಯಾ ಫಲ ಪಾವೂ ।", "ತುಮ್ಹರೋ ಯಶ ಮೈಂ ಸದಾ ಸುನಾವೂ ॥ 39 ॥"]},
    {"type": "chaupai", "number": 40, "lines": ["ದುರ್ಗಾ ಚಾಲೀಸಾ ಜೋ ಗಾವೈ ।", "ಸಬ ಸುಖ ಭೋಗ ಪರಮಪದ ಪಾವೈ ॥ 40 ॥"]},
    {"type": "doha", "lines": ["ದೇವೀದಾಸ ಶರಣ ನಿಜ ಜಾನೀ ।", "ಕರಹು ಕೃಪಾ ಜಗದಂಬ ಭವಾನೀ ॥"]}
  ]
}

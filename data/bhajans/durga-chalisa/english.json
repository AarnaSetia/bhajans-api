{
  "id": "durga-chalisa",
  "title": "Durgā Cālīsā",
  "lyrics": [
    {"type": "chaupai", "number": 1, "lines": ["namō namō durgē sukha karanī ।", "namō namō ambē duḥkha haranī ॥ 1 ॥"]},
    {"type": "chaupai", "number": 2, "lines": ["niraṅkāra hai jyōti tumhārī ।", "tihū lōka phailī ujiyārī ॥ 2 ॥"]},
    {"type": "chaupai", "number": 3, "lines": ["śaśi lalāṭa mukha mahāviśālā ।", "nētra lāla bhṛkuṭi vikarālā ॥ 3 ॥"]},
    {"type": "chaupai", "number": 4, "lines": ["rūpa mātu kō adhika suhāvē ।", "daraśa karata jana ati sukha pāvē ॥ 4 ॥"]},
    {"type": "chaupai", "number": 5, "lines": ["tuma saṃsāra śakti laya kīnā ।", "pālana hētu anna dhana dīnā ॥ 5 ॥"]},
    {"type": "chaupai", "number": 6, "lines": ["annapūrṇā huyi jaga pālā ।", "tuma hī ādi sundarī bālā ॥ 6 ॥"]},
    {"type": "chaupai", "number": 7, "lines": ["pralayakāla saba nāśana hārī ।", "tuma gaurī śiva śaṅkara pyārī ॥ 7 ॥"]},
    {"type": "chaupai", "number": 8, "lines": ["śiva yōgī tumharē guṇa gāvēm ।", "brahmā viṣṇu tumhēṃ nita dhyāvēm ॥ 8 ॥"]},
    {"type": "chaupai", "number": 9, "lines": ["rūpa sarasvatī kā tuma dhārā ।", "dē subuddhi ṛṣi munina ubārā ॥ 9 ॥"]},
    {"type": "chaupai", "number": 10, "lines": ["dharā rūpa narasiṃha kō ambā ।", "paragaṭa bhayi phāḍa kē khambā ॥ 10 ॥"]},
    {"type": "chaupai", "number": 11, "lines": ["rakṣā kara prahlāda bachāyō ।", "hiraṇyākṣa kō svarga paṭhāyō ॥ 11 ॥"]},
    {"type": "chaupai", "number": 12, "lines": ["lakṣmī rūpa dharō jaga māhīm ।", "śrī nārāyaṇa aṅga samāhīm ॥ 12 ॥"]},
    {"type": "chaupai", "number": 13, "lines": ["kṣīrasindhu mēṃ karata vilāsā ।", "dayāsindhu dījai mana āsā ॥ 13 ॥"]},
    {"type": "chaupai", "number": 14, "lines": ["hiṅgalāja mēṃ tumhīṃ bhavānī ।", "mahimā amita na jāta bakhānī ॥ 14 ॥"]},
    {"type": "chaupai", "number": 15, "lines": ["mātaṅgī dhūmāvati mātā ।", "bhuvanēśvarī bagalā sukhadātā ॥ 15 ॥"]},
    {"type": "chaupai", "number": 16, "lines": ["śrī bhairava tārā jaga tāriṇī ।", "chinna bhāla bhava duḥkha nivāriṇī ॥ 16 ॥"]},
    {"type": "chaupai", "number": 17, "lines": ["kēhari vāhana sōha bhavānī ।", "lāṅgura vīra chalata agavānī ॥ 17 ॥"]},
    {"type": "chaupai", "number": 18, "lines": ["kara mēṃ khappara khaḍaga virājē ।", "jākō dēkha kāla ḍara bhājē ॥ 18 ॥"]},
    {"type": "chaupai", "number": 19, "lines": ["tōhē kara mēṃ astra triśūlā ।", "jātē uṭhata śatru hiya śūlā ॥ 19 ॥"]},
    {"type": "chaupai", "number": 20, "lines": ["nagarakōṭi mēṃ tumhīṃ virājata ।", "tihuँ lōka mēṃ ḍaṅkā bājata ॥ 20 ॥"]},
    {"type": "chaupai", "number": 21, "lines": ["śumbha niśumbha dānava tuma mārē ।", "raktabīja śaṅkhana saṃhārē ॥ 21 ॥"]},
    {"type": "chaupai", "number": 22, "lines": ["mahiṣāsura nṛpa ati abhimānī ।", "jēhi agha bhāra mahī akulānī ॥ 22 ॥"]},
    {"type": "chaupai", "number": 23, "lines": ["rūpa karāla kālikā dhārā ।", "sēna sahita tuma tihi saṃhārā ॥ 23 ॥"]},
    {"type": "chaupai", "number": 24, "lines": ["paḍī bhīḍha santana para jaba jaba ।", "bhayi sahāya mātu tuma taba taba ॥ 24 ॥"]},
    {"type": "chaupai", "number": 25, "lines": ["amarapurī aru bāsava lōkā ।", "taba mahimā saba kahēṃ aśōkā ॥ 25 ॥"]},
    {"type": "chaupai", "number": 26, "lines": ["jvālā mēṃ hai jyōti tumhārī ।", "tumhēṃ sadā pūjēṃ nara nārī ॥ 26 ॥"]},
    {"type": "chaupai", "number": 27, "lines": ["prēma bhakti sē jō yaśa gāvēm ।", "duḥkha dāridra nikaṭa nahiṃ āvēm ॥ 27 ॥"]},
    {"type": "chaupai", "number": 28, "lines": ["dhyāvē tumhēṃ jō nara mana lāyi ।", "janma maraṇa tē sauṃ chuṭa jāyi ॥ 28 ॥"]},
    {"type": "chaupai", "number": 29, "lines": ["jōgī sura muni kahata pukārī ।", "yōga na hōyi bina śakti tumhārī ॥ 29 ॥"]},
    {"type": "chaupai", "number": 30, "lines": ["śaṅkara āchāraja tapa kīnō ।", "kāma aru krōdha jīta saba līnō ॥ 30 ॥"]},
    {"type": "chaupai", "number": 31, "lines": ["niśidina dhyāna dharō śaṅkara kō ।", "kāhu kāla nahiṃ sumirō tumakō ॥ 31 ॥"]},
    {"type": "chaupai", "number": 32, "lines": ["śakti rūpa kō marama na pāyō ।", "śakti gayī taba mana pachatāyō ॥ 32 ॥"]},
    {"type": "chaupai", "number": 33, "lines": ["śaraṇāgata huyi kīrti bakhānī ।", "jaya jaya jaya jagadamba bhavānī ॥ 33 ॥"]},
    {"type": "chaupai", "number": 34, "lines": ["bhayi prasanna ādi jagadambā ।", "dayi śakti nahiṃ kīna vilambā ॥ 34 ॥"]},
    {"type": "chaupai", "number": 35, "lines": ["mōkō mātu kaṣṭa ati ghērō ।", "tuma bina kauna harai duḥkha mērō ॥ 35 ॥"]},
    {"type": "chaupai", "number": 36, "lines": ["āśā tṛṣṇā nipaṭa satāvēm ।", "ripu mūrakha mohi ati dara pāvaim ॥ 36 ॥"]},
    {"type": "chaupai", "number": 37, "lines": ["śatru nāśa kījai mahārānī ।", "sumirauṃ ikachita tumhēṃ bhavānī ॥ 37 ॥"]},
    {"type": "chaupai", "number": 38, "lines": ["karō kṛpā hē mātu dayālā ।", "ṛddhi-siddhi dē karahu nihālā ॥ 38 ॥"]},
    {"type": "chaupai", "number": 39, "lines": ["jaba lagi jiyū dayā phala pāvū ।", "tumharō yaśa maiṃ sadā sunāvū ॥ 39 ॥"]},
    {"type": "chaupai", "number": 40, "lines": ["durgā chālīsā jō gāvai ।", "saba sukha bhōga paramapada pāvai ॥ 40 ॥"]},
    {"type": "doha", "lines": ["dēvīdāsa śaraṇa nija jānī ।", "karahu kṛpā jagadamba bhavānī ॥"]}
  ]
}

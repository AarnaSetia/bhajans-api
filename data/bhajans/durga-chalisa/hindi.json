{
  "id": "durga-chalisa",
  "title": "दुर्गा चालीसा",
  "lyrics": [
    {"type": "chaupai", "number": 1, "lines": ["नमो नमो दुर्गे सुख करनी ।", "नमो नमो अंबे दुःख हरनी ॥ 1 ॥"]},
    {"type": "chaupai", "number": 2, "lines": ["निरंकार है ज्योति तुम्हारी ।", "तिहू लोक फैली उजियारी ॥ 2 ॥"]},
    {"type": "chaupai", "number": 3, "lines": ["शशि ललाट मुख महाविशाला ।", "नेत्र लाल भृकुटि विकराला ॥ 3 ॥"]},
    {"type": "chaupai", "number": 4, "lines": ["रूप मातु को अधिक सुहावे ।", "दरश करत जन अति सुख पावे ॥ 4 ॥"]},
    {"type": "chaupai", "number": 5, "lines": ["तुम संसार शक्ति लय कीना ।", "पालन हेतु अन्न धन दीना ॥ 5 ॥"]},
    {"type": "chaupai", "number": 6, "lines": ["अन्नपूर्णा हुयि जग पाला ।", "तुम ही आदि सुंदरी बाला ॥ 6 ॥"]},
    {"type": "chaupai", "number": 7, "lines": ["प्रलयकाल सब नाशन हारी ।", "तुम गौरी शिव शंकर प्यारी ॥ 7 ॥"]},
    {"type": "chaupai", "number": 8, "lines": ["शिव योगी तुम्हरे गुण गावेम् ।", "ब्रह्मा विष्णु तुम्हें नित ध्यावेम् ॥ 8 ॥"]},
    {"type": "chaupai", "number": 9, "lines": ["रूप सरस्वती का तुम धारा ।", "दे सुबुद्धि ऋषि मुनिन उबारा ॥ 9 ॥"]},
    {"type": "chaupai", "number": 10, "lines": ["धरा रूप नरसिंह को अंबा ।", "परगट भयि फाड के खंबा ॥ 10 ॥"]},
    {"type": "chaupai", "number": 11, "lines": ["रक्षा कर प्रह्लाद बचायो ।", "हिरण्याक्ष को स्वर्ग पठायो ॥ 11 ॥"]},
    {"type": "chaupai", "number": 12, "lines": ["लक्ष्मी रूप धरो जग माहीम् ।", "श्री नारायण अंग समाहीम् ॥ 12 ॥"]},
    {"type": "chaupai", "number": 13, "lines": ["क्षीरसिंधु में करत विलासा ।", "दयासिंधु दीजै मन आसा ॥ 13 ॥"]},
    {"type": "chaupai", "number": 14, "lines": ["हिंगलाज में तुम्हीं भवानी ।", "महिमा अमित न जात बखानी ॥ 14 ॥"]},
    {"type": "chaupai", "number": 15, "lines": ["मातंगी धूमावति माता ।", "भुवनेश्वरी बगला सुखदाता ॥ 15 ॥"]},
    {"type": "chaupai", "number": 16, "lines": ["श्री भैरव तारा जग तारिणी ।", "छिन्न भाल भव दुःख निवारिणी ॥ 16 ॥"]},
    {"type": "chaupai", "number": 17, "lines": ["केहरि वाहन सोह भवानी ।", "लांगुर वीर चलत अगवानी ॥ 17 ॥"]},
    {"type": "chaupai", "number": 18, "lines": ["कर में खप्पर खडग विराजे ।", "जाको देख काल डर भाजे ॥ 18 ॥"]},
    {"type": "chaupai", "number": 19, "lines": ["तोहे कर में अस्त्र त्रिशूला ।", "जाते उठत शत्रु हिय शूला ॥ 19 ॥"]},
    {"type": "chaupai", "number": 20, "lines": ["नगरकोटि में तुम्हीं विराजत ।", "तिहुँ लोक में डंका बाजत ॥ 20 ॥"]},
    {"type": "chaupai", "number": 21, "lines": ["शुंभ निशुंभ दानव तुम मारे ।", "रक्तबीज शंखन संहारे ॥ 21 ॥"]},
    {"type": "chaupai", "number": 22, "lines": ["महिषासुर नृप अति अभिमानी ।", "जेहि अघ भार मही अकुलानी ॥ 22 ॥"]},
    {"type": "chaupai", "number": 23, "lines": ["रूप कराल कालिका धारा ।", "सेन सहित तुम तिहि संहारा ॥ 23 ॥"]},
    {"type": "chaupai", "number": 24, "lines": ["पडी भीढ संतन पर जब जब ।", "भयि सहाय मातु तुम तब तब ॥ 24 ॥"]},
    {"type": "chaupai", "number": 25, "lines": ["अमरपुरी अरु बासव लोका ।", "तब महिमा सब कहें अशोका ॥ 25 ॥"]},
    {"type": "chaupai", "number": 26, "lines": ["ज्वाला में है ज्योति तुम्हारी ।", "तुम्हें सदा पूजें नर नारी ॥ 26 ॥"]},
    {"type": "chaupai", "number": 27, "lines": ["प्रेम भक्ति से जो यश गावेम् ।", "दुःख दारिद्र निकट नहिं आवेम् ॥ 27 ॥"]},
    {"type": "chaupai", "number": 28, "lines": ["ध्यावे तुम्हें जो नर मन लायि ।", "जन्म मरण ते सौं छुट जायि ॥ 28 ॥"]},
    {"type": "chaupai", "number": 29, "lines": ["जोगी सुर मुनि कहत पुकारी ।", "योग न होयि बिन शक्ति तुम्हारी ॥ 29 ॥"]},
    {"type": "chaupai", "number": 30, "lines": ["शंकर आचारज तप कीनो ।", "काम अरु क्रोध जीत सब लीनो ॥ 30 ॥"]},
    {"type": "chaupai", "number": 31, "lines": ["निशिदिन ध्यान धरो शंकर को ।", "काहु काल नहिं सुमिरो तुमको ॥ 31 ॥"]},
    {"type": "chaupai", "number": 32, "lines": ["शक्ति रूप को मरम न पायो ।", "शक्ति गयी तब मन पछतायो ॥ 32 ॥"]},
    {"type": "chaupai", "number": 33, "lines": ["शरणागत हुयि कीर्ति बखानी ।", "जय जय जय जगदंब भवानी ॥ 33 ॥"]},
    {"type": "chaupai", "number": 34, "lines": ["भयि प्रसन्न आदि जगदंबा ।", "दयि शक्ति नहिं कीन विलंबा ॥ 34 ॥"]},
    {"type": "chaupai", "number": 35, "lines": ["मोको मातु कष्ट अति घेरो ।", "तुम बिन कौन हरै दुःख मेरो ॥ 35 ॥"]},
    {"type": "chaupai", "number": 36, "lines": ["आशा तृष्णा निपट सतावेम् ।", "रिपु मूरख मॊहि अति दर पावैम् ॥ 36 ॥"]},
    {"type": "chaupai", "number": 37, "lines": ["शत्रु नाश कीजै महारानी ।", "सुमिरौं इकचित तुम्हें भवानी ॥ 37 ॥"]},
    {"type": "chaupai", "number": 38, "lines": ["करो कृपा हे मातु दयाला ।", "ऋद्धि-सिद्धि दे करहु निहाला ॥ 38 ॥"]},
    {"type": "chaupai", "number": 39, "lines": ["जब लगि जियू दया फल पावू ।", "तुम्हरो यश मैं सदा सुनावू ॥ 39 ॥"]},
    {"type": "chaupai", "number": 40, "lines": ["दुर्गा चालीसा जो गावै ।", "सब सुख भोग परमपद पावै ॥ 40 ॥"]},
    {"type": "doha", "lines": ["देवीदास शरण निज जानी ।", "करहु कृपा जगदंब भवानी ॥"]}
  ]
}

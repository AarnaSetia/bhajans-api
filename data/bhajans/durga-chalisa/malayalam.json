{
  "id": "durga-chalisa",
  "title": "ദുർഗ്ഗ ചാലീസ",
  "lyrics": [
    {"type": "chaupai", "number": 1, "lines": ["നമോ നമോ ദുർഗേ സുഖ കരനീ ।", "നമോ നമോ അംബേ ദുഃഖ ഹരനീ ॥ 1 ॥"]},
    {"type": "chaupai", "number": 2, "lines": ["നിരംകാര ഹൈ ജ്യോതി തുമ്ഹാരീ ।", "തിഹൂ ലോക ഫൈലീ ഉജിയാരീ ॥ 2 ॥"]},
    {"type": "chaupai", "number": 3, "lines": ["ശശി ലലാട മുഖ മഹാവിശാലാ ।", "നേത്ര ലാല ഭൃകുടി വികരാലാ ॥ 3 ॥"]},
    {"type": "chaupai", "number": 4, "lines": ["രൂപ മാതു കോ അധിക സുഹാവേ ।", "ദരശ കരത ജന അതി സുഖ പാവേ ॥ 4 ॥"]},
    {"type": "chaupai", "number": 5, "lines": ["തുമ സംസാര ശക്തി ലയ കീനാ ।", "പാലന ഹേതു അന്ന ധന ദീനാ ॥ 5 ॥"]},
    {"type": "chaupai", "number": 6, "lines": ["അന്നപൂർണാ ഹുയി ജഗ പാലാ ।", "തുമ ഹീ ആദി സുംദരീ ബാലാ ॥ 6 ॥"]},
    {"type": "chaupai", "number": 7, "lines": ["പ്രലയകാല സബ നാശന ഹാരീ ।", "തുമ ഗൌരീ ശിവ ശംകര പ്യാരീ ॥ 7 ॥"]},
    {"type": "chaupai", "number": 8, "lines": ["ശിവ യോഗീ തുമ്ഹരേ ഗുണ ഗാവേമ് ।", "ബ്രഹ്മാ വിഷ്ണു തുമ്ഹേം നിത ധ്യാവേമ് ॥ 8 ॥"]},
    {"type": "chaupai", "number": 9, "lines": ["രൂപ സരസ്വതീ കാ തുമ ധാരാ ।", "ദേ സുബുദ്ധി ഋഷി മുനിന ഉബാരാ ॥ 9 ॥"]},
    {"type": "chaupai", "number": 10, "lines": ["ധരാ രൂപ നരസിംഹ കോ അംബാ ।", "പരഗട ഭയി ഫാഡ കേ ഖംബാ ॥ 10 ॥"]},
    {"type": "chaupai", "number": 11, "lines": ["രക്ഷാ കര പ്രഹ്ലാദ ബചായോ ।", "ഹിരണ്യാക്ഷ കോ സ്വർഗ പഠായോ ॥ 11 ॥"]},
    {"type": "chaupai", "number": 12, "lines": ["ലക്ഷ്മീ രൂപ ധരോ ജഗ മാഹീമ് ।", "ശ്രീ നാരായണ അംഗ സമാഹീമ് ॥ 12 ॥"]},
    {"type": "chaupai", "number": 13, "lines": ["ക്ഷീരസിംധു മേം കരത വിലാസാ ।", "ദയാസിംധു ദീജൈ മന ആസാ ॥ 13 ॥"]},
    {"type": "chaupai", "number": 14, "lines": ["ഹിംഗലാജ മേം തുമ്ഹീം ഭവാനീ ।", "മഹിമാ അമിത ന ജാത ബഖാനീ ॥ 14 ॥"]},
    {"type": "chaupai", "number": 15, "lines": ["മാതംഗീ ധൂമാവതി മാതാ ।", "ഭുവനേശ്വരീ ബഗലാ സുഖദാതാ ॥ 15 ॥"]},
    {"type": "chaupai", "number": 16, "lines": ["ശ്രീ ഭൈരവ താരാ ജഗ താരിണീ ।", "ഛിന്ന ഭാല ഭവ ദുഃഖ നിവാരിണീ ॥ 16 ॥"]},
    {"type": "chaupai", "number": 17, "lines": ["കേഹരി വാഹന സോഹ ഭവാനീ ।", "ലാംഗുര വീര ചലത അഗവാനീ ॥ 17 ॥"]},
    {"type": "chaupai", "number": 18, "lines": ["കര മേം ഖപ്പര ഖഡഗ വിരാജേ ।", "ജാകോ ദേഖ കാല ഡര ഭാജേ ॥ 18 ॥"]},
    {"type": "chaupai", "number": 19, "lines": ["തോഹേ കര മേം അസ്ത്ര ത്രിശൂലാ ।", "ജാതേ ഉഠത ശത്രു ഹിയ ശൂലാ ॥ 19 ॥"]},
    {"type": "chaupai", "number": 20, "lines": ["നഗരകോടി മേം തുമ്ഹീം വിരാജത ।", "തിഹുഁ ലോക മേം ഡംകാ ബാജത ॥ 20 ॥"]},
    {"type": "chaupai", "number": 21, "lines": ["ശുംഭ നിശുംഭ ദാനവ തുമ മാരേ ।", "രക്തബീജ ശംഖന സംഹാരേ ॥ 21 ॥"]},
    {"type": "chaupai", "number": 22, "lines": ["മഹിഷാസുര നൃപ അതി അഭിമാനീ ।", "ജേഹി അഘ ഭാര മഹീ അകുലാനീ ॥ 22 ॥"]},
    {"type": "chaupai", "number": 23, "lines": ["രൂപ കരാല കാലികാ ധാരാ ।", "സേന സഹിത തുമ തിഹി സംഹാരാ ॥ 23 ॥"]},
    {"type": "chaupai", "number": 24, "lines": ["പഡീ ഭീഢ സംതന പര ജബ ജബ ।", "ഭയി സഹായ മാതു തുമ തബ തബ ॥ 24 ॥"]},
    {"type": "chaupai", "number": 25, "lines": ["അമരപുരീ അരു ബാസവ ലോകാ ।", "തബ മഹിമാ സബ കഹേം അശോകാ ॥ 25 ॥"]},
    {"type": "chaupai", "number": 26, "lines": ["ജ്വാലാ മേം ഹൈ ജ്യോതി തുമ്ഹാരീ ।", "തുമ്ഹേം സദാ പൂജേം നര നാരീ ॥ 26 ॥"]},
    {"type": "chaupai", "number": 27, "lines": ["പ്രേമ ഭക്തി സേ ജോ യശ ഗാവേമ് ।", "ദുഃഖ ദാരിദ്ര നികട നഹിം ആവേമ് ॥ 27 ॥"]},
    {"type": "chaupai", "number": 28, "lines": ["ധ്യാവേ തുമ്ഹേം ജോ നര മന ലായി ।", "ജന്മ മരണ തേ സൌം ഛുട ജായി ॥ 28 ॥"]},
    {"type": "chaupai", "number": 29, "lines": ["ജോഗീ സുര മുനി കഹത പുകാരീ ।", "യോഗ ന ഹോയി ബിന ശക്തി തുമ്ഹാരീ ॥ 29 ॥"]},
    {"type": "chaupai", "number": 30, "lines": ["ശംകര ആചാരജ തപ കീനോ ।", "കാമ അരു ക്രോധ ജീത സബ ലീനോ ॥ 30 ॥"]},
    {"type": "chaupai", "number": 31, "lines": ["നിശിദിന ധ്യാന ധരോ ശംകര കോ ।", "കാഹു കാല നഹിം സുമിരോ തുമകോ ॥ 31 ॥"]},
    {"type": "chaupai", "number": 32, "lines": ["ശക്തി രൂപ കോ മരമ ന പായോ ।", "ശക്തി ഗയീ തബ മന പഛതായോ ॥ 32 ॥"]},
    {"type": "chaupai", "number": 33, "lines": ["ശരണാഗത ഹുയി കീർതി ബഖാനീ ।", "ജയ ജയ ജയ ജഗദംബ ഭവാനീ ॥ 33 ॥"]},
    {"type": "chaupai", "number": 34, "lines": ["ഭയി പ്രസന്ന ആദി ജഗദംബാ ।", "ദയി ശക്തി നഹിം കീന വിലംബാ ॥ 34 ॥"]},
    {"type": "chaupai", "number": 35, "lines": ["മോകോ മാതു കഷ്ട അതി ഘേരോ ।", "തുമ ബിന കൌന ഹരൈ ദുഃഖ മേരോ ॥ 35 ॥"]},
    {"type": "chaupai", "number": 36, "lines": ["ആശാ തൃഷ്ണാ നിപട സതാവേമ് ।", "രിപു മൂരഖ മൊഹി അതി ദര പാവൈമ് ॥ 36 ॥"]},
    {"type": "chaupai", "number": 37, "lines": ["ശത്രു നാശ കീജൈ മഹാരാനീ ।", "സുമിരൌം ഇകചിത തുമ്ഹേം ഭവാനീ ॥ 37 ॥"]},
    {"type": "chaupai", "number": 38, "lines": ["കരോ കൃപാ ഹേ മാതു ദയാലാ ।", "ഋദ്ധി-സിദ്ധി ദേ കരഹു നിഹാലാ ॥ 38 ॥"]},
    {"type": "chaupai", "number": 39, "lines": ["ജബ ലഗി ജിയൂ ദയാ ഫല പാവൂ ।", "തുമ്ഹരോ യശ മൈം സദാ സുനാവൂ ॥ 39 ॥"]},
    {"type": "chaupai", "number": 40, "lines": ["ദുർഗ്ഗ ചാലീസ ജോ ഗാവൈ ।", "സബ സുഖ ഭോഗ പരമപദ പാവൈ ॥ 40 ॥"]},
    {"type": "doha", "lines": ["ദേവീദാസ ശരണ നിജ ജാനീ ।", "കരഹു കൃപാ ജഗദംബ ഭവാനീ ॥"]}
  ]
}

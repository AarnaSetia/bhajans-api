{
  "id": "durga-chalisa",
  "title": "து³ர்கா³ சாலீஸா",
  "lyrics": [
    {"type": "chaupai", "number": 1, "lines": ["நமோ நமோ து³ர்கே³ ஸுக² கரனீ ।", "நமோ நமோ அம்பே³ து³:க² ஹரனீ ॥ 1 ॥"]},
    {"type": "chaupai", "number": 2, "lines": ["நிரங்கார ஹை ஜ்யோதி தும்ஹாரீ ।", "திஹூ லோக பை²லீ உஜியாரீ ॥ 2 ॥"]},
    {"type": "chaupai", "number": 3, "lines": ["ஶஶி லலாட முக² மஹாவிஶாலா ।", "நேத்ர லால ப்⁴ருகுடி விகராலா ॥ 3 ॥"]},
    {"type": "chaupai", "number": 4, "lines": ["ரூப மாது கோ அதி⁴க ஸுஹாவே ।", "த³ரஶ கரத ஜன அதி ஸுக² பாவே ॥ 4 ॥"]},
    {"type": "chaupai", "number": 5, "lines": ["தும ஸம்ஸார ஶக்தி லய கீனா ।", "பாலன ஹேது அன்ன த⁴ன தீ³னா ॥ 5 ॥"]},
    {"type": "chaupai", "number": 6, "lines": ["அன்னபூர்ணா ஹுயி ஜக³ பாலா ।", "தும ஹீ ஆதி³ ஸுந்த³ரீ பா³லா ॥ 6 ॥"]},
    {"type": "chaupai", "number": 7, "lines": ["ப்ரலயகால ஸப³ நாஶன ஹாரீ ।", "தும கௌ³ரீ ஶிவ ஶங்கர ப்யாரீ ॥ 7 ॥"]},
    {"type": "chaupai", "number": 8, "lines": ["ஶிவ யோகீ³ தும்ஹரே கு³ண கா³வேம் ।", "ப்³ரஹ்மா விஷ்ணு தும்ஹேம் நித த்⁴யாவேம் ॥ 8 ॥"]},
    {"type": "chaupai", "number": 9, "lines": ["ரூப ஸரஸ்வதீ கா தும தா⁴ரா ।", "தே³ ஸுபு³த்³தி⁴ ருஷி முனின உபா³ரா ॥ 9 ॥"]},
    {"type": "chaupai", "number": 10, "lines": ["த⁴ரா ரூப நரஸிம்ஹ கோ அம்பா³ ।", "பரக³ட ப⁴யி பா²ட³ கே க²ம்பா³ ॥ 10 ॥"]},
    {"type": "chaupai", "number": 11, "lines": ["ரக்ஷா கர ப்ரஹ்லாத³ ப³சாயோ ।", "ஹிரண்யாக்ஷ கோ ஸ்வர்க³ படா²யோ ॥ 11 ॥"]},
    {"type": "chaupai", "number": 12, "lines": ["லக்ஷ்மீ ரூப த⁴ரோ ஜக³ மாஹீம் ।", "ஶ்ரீ நாராயண அங்க³ ஸமாஹீம் ॥ 12 ॥"]},
    {"type": "chaupai", "number": 13, "lines": ["க்ஷீரஸிந்து⁴ மேம் கரத விலாஸா ।", "த³யாஸிந்து⁴ தீ³ஜை மன ஆஸா ॥ 13 ॥"]},
    {"type": "chaupai", "number": 14, "lines": ["ஹிங்க³லாஜ மேம் தும்ஹீம் ப⁴வானீ ।", "மஹிமா அமித ந ஜாத ப³கா²னீ ॥ 14 ॥"]},
    {"type": "chaupai", "number": 15, "lines": ["மாதங்கீ³ தூ⁴மாவதி மாதா ।", "பு⁴வனேஶ்வரீ ப³க³லா ஸுக²தா³தா ॥ 15 ॥"]},
    {"type": "chaupai", "number": 16, "lines": ["ஶ்ரீ பை⁴ரவ தாரா ஜக³ தாரிணீ ।", "சி²ன்ன பா⁴ல ப⁴வ து³:க² நிவாரிணீ ॥ 16 ॥"]},
    {"type": "chaupai", "number": 17, "lines": ["கேஹரி வாஹன ஸோஹ ப⁴வானீ ।", "லாங்கு³ர வீர சலத அக³வானீ ॥ 17 ॥"]},
    {"type": "chaupai", "number": 18, "lines": ["கர மேம் க²ப்பர க²ட³க³ விராஜே ।", "ஜாகோ தே³க² கால ட³ர பா⁴ஜே ॥ 18 ॥"]},
    {"type": "chaupai", "number": 19, "lines": ["தோஹே கர மேம் அஸ்த்ர த்ரிஶூலா ।", "ஜாதே உட²த ஶத்ரு ஹிய ஶூலா ॥ 19 ॥"]},
    {"type": "chaupai", "number": 20, "lines": ["நக³ரகோடி மேம் தும்ஹீம் விராஜத ।", "திஹு஁ லோக மேம் ட³ங்கா பா³ஜத ॥ 20 ॥"]},
    {"type": "chaupai", "number": 21, "lines": ["ஶும்ப⁴ நிஶும்ப⁴ தா³னவ தும மாரே ।", "ரக்தபீ³ஜ ஶங்க³ன ஸம்ஹாரே ॥ 21 ॥"]},
    {"type": "chaupai", "number": 22, "lines": ["மஹிஷாஸுர ந்ருப அதி அபி⁴மானீ ।", "ஜேஹி அக⁴ பா⁴ர மஹீ அகுலானீ ॥ 22 ॥"]},
    {"type": "chaupai", "number": 23, "lines": ["ரூப கரால காலிகா தா⁴ரா ।", "ஸேன ஸஹித தும திஹி ஸம்ஹாரா ॥ 23 ॥"]},
    {"type": "chaupai", "number": 24, "lines": ["படீ³ பீ⁴ட⁴ ஸந்தன பர ஜப³ ஜப³ ।", "ப⁴யி ஸஹாய மாது தும தப³ தப³ ॥ 24 ॥"]},
    {"type": "chaupai", "number": 25, "lines": ["அமரபுரீ அரு பா³ஸவ லோகா ।", "தப³ மஹிமா ஸப³ கஹேம் அஶோகா ॥ 25 ॥"]},
    {"type": "chaupai", "number": 26, "lines": ["ஜ்வாலா மேம் ஹை ஜ்யோதி தும்ஹாரீ ।", "தும்ஹேம் ஸதா³ பூஜேம் நர நாரீ ॥ 26 ॥"]},
    {"type": "chaupai", "number": 27, "lines": ["ப்ரேம ப⁴க்தி ஸே ஜோ யஶ கா³வேம் ।", "து³:க² தா³ரித்³ர நிகட நஹிம் ஆவேம் ॥ 27 ॥"]},
    {"type": "chaupai", "number": 28, "lines": ["த்⁴யாவே தும்ஹேம் ஜோ நர மன லாயி ।", "ஜன்ம மரண தே ஸௌம் சு²ட ஜாயி ॥ 28 ॥"]},
    {"type": "chaupai", "number": 29, "lines": ["ஜோகீ³ ஸுர முனி கஹத புகாரீ ।", "யோக³ ந ஹோயி பி³ன ஶக்தி தும்ஹாரீ ॥ 29 ॥"]},
    {"type": "chaupai", "number": 30, "lines": ["ஶங்கர ஆசாரஜ தப கீனோ ।", "காம அரு க்ரோத⁴ ஜீத ஸப³ லீனோ ॥ 30 ॥"]},
    {"type": "chaupai", "number": 31, "lines": ["நிஶிதி³ன த்⁴யான த⁴ரோ ஶங்கர கோ ।", "காஹு கால நஹிம் ஸுமிரோ துமகோ ॥ 31 ॥"]},
    {"type": "chaupai", "number": 32, "lines": ["ஶக்தி ரூப கோ மரம ந பாயோ ।", "ஶக்தி க³யீ தப³ மன பச²தாயோ ॥ 32 ॥"]},
    {"type": "chaupai", "number": 33, "lines": ["ஶரணாக³த ஹுயி கீர்தி ப³கா²னீ ।", "ஜய ஜய ஜய ஜக³த³ம்ப³ ப⁴வானீ ॥ 33 ॥"]},
    {"type": "chaupai", "number": 34, "lines": ["ப⁴யி ப்ரஸன்ன ஆதி³ ஜக³த³ம்பா³ ।", "த³யி ஶக்தி நஹிம் கீன விலம்பா³ ॥ 34 ॥"]},
    {"type": "chaupai", "number": 35, "lines": ["மோகோ மாது கஷ்ட அதி கே⁴ரோ ।", "தும பி³ன கௌன ஹரை து³:க² மேரோ ॥ 35 ॥"]},
    {"type": "chaupai", "number": 36, "lines": ["ஆஶா த்ருஷ்ணா நிபட ஸதாவேம் ।", "ரிபு மூரக² மொஹி அதி த³ர பாவைம் ॥ 36 ॥"]},
    {"type": "chaupai", "number": 37, "lines": ["ஶத்ரு நாஶ கீஜை மஹாரானீ ।", "ஸுமிரௌம் இகசித தும்ஹேம் ப⁴வானீ ॥ 37 ॥"]},
    {"type": "chaupai", "number": 38, "lines": ["கரோ க்ருபா ஹே மாது த³யாலா ।", "ருத்³தி⁴-ஸித்³தி⁴ தே³ கரஹு நிஹாலா ॥ 38 ॥"]},
    {"type": "chaupai", "number": 39, "lines": ["ஜப³ லகி³ ஜியூ த³யா ப²ல பாவூ ।", "தும்ஹரோ யஶ மைம் ஸதா³ ஸுனாவூ ॥ 39 ॥"]},
    {"type": "chaupai", "number": 40, "lines": ["து³ர்கா³ சாலீஸா ஜோ கா³வை ।", "ஸப³ ஸுக² போ⁴க³ பரமபத³ பாவை ॥ 40 ॥"]},
    {"type": "doha", "lines": ["தே³வீதா³ஸ ஶரண நிஜ ஜானீ ।", "கரஹு க்ருபா ஜக³த³ம்ப³ ப⁴வானீ ॥"]}
  ]
}

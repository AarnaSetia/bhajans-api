{
  "id": "durga-chalisa",
  "title": "దుర్గా చాలీసా",
  "lyrics": [
    {"type": "chaupai", "number": 1, "lines": ["నమో నమో దుర్గే సుఖ కరనీ ।", "నమో నమో అంబే దుఃఖ హరనీ ॥ 1 ॥"]},
    {"type": "chaupai", "number": 2, "lines": ["నిరంకార హై జ్యోతి తుమ్హారీ ।", "తిహూ లోక ఫైలీ ఉజియారీ ॥ 2 ॥"]},
    {"type": "chaupai", "number": 3, "lines": ["శశి లలాట ముఖ మహావిశాలా ।", "నేత్ర లాల భృకుటి వికరాలా ॥ 3 ॥"]},
    {"type": "chaupai", "number": 4, "lines": ["రూప మాతు కో అధిక సుహావే ।", "దరశ కరత జన అతి సుఖ పావే ॥ 4 ॥"]},
    {"type": "chaupai", "number": 5, "lines": ["తుమ సంసార శక్తి లయ కీనా ।", "పాలన హేతు అన్న ధన దీనా ॥ 5 ॥"]},
    {"type": "chaupai", "number": 6, "lines": ["అన్నపూర్ణా హుయి జగ పాలా ।", "తుమ హీ ఆది సుందరీ బాలా ॥ 6 ॥"]},
    {"type": "chaupai", "number": 7, "lines": ["ప్రలయకాల సబ నాశన హారీ ।", "తుమ గౌరీ శివ శంకర ప్యారీ ॥ 7 ॥"]},
    {"type": "chaupai", "number": 8, "lines": ["శివ యోగీ తుమ్హరే గుణ గావేమ్ ।", "బ్రహ్మా విష్ణు తుమ్హేం నిత ధ్యావేమ్ ॥ 8 ॥"]},
    {"type": "chaupai", "number": 9, "lines": ["రూప సరస్వతీ కా తుమ ధారా ।", "దే సుబుద్ధి ఋషి మునిన ఉబారా ॥ 9 ॥"]},
    {"type": "chaupai", "number": 10, "lines": ["ధరా రూప నరసింహ కో అంబా ।", "పరగట భయి ఫాడ కే ఖంబా ॥ 10 ॥"]},
    {"type": "chaupai", "number": 11, "lines": ["రక్షా కర ప్రహ్లాద బచాయో ।", "హిరణ్యాక్ష కో స్వర్గ పఠాయో ॥ 11 ॥"]},
    {"type": "chaupai", "number": 12, "lines": ["లక్ష్మీ రూప ధరో జగ మాహీమ్ ।", "శ్రీ నారాయణ అంగ సమాహీమ్ ॥ 12 ॥"]},
    {"type": "chaupai", "number": 13, "lines": ["క్షీరసింధు మేం కరత విలాసా ।", "దయాసింధు దీజై మన ఆసా ॥ 13 ॥"]},
    {"type": "chaupai", "number": 14, "lines": ["హింగలాజ మేం తుమ్హీం భవానీ ।", "మహిమా అమిత న జాత బఖానీ ॥ 14 ॥"]},
    {"type": "chaupai", "number": 15, "lines": ["మాతంగీ ధూమావతి మాతా ।", "భువనేశ్వరీ బగలా సుఖదాతా ॥ 15 ॥"]},
    {"type": "chaupai", "number": 16, "lines": ["శ్రీ భైరవ తారా జగ తారిణీ ।", "ఛిన్న భాల భవ దుఃఖ నివారిణీ ॥ 16 ॥"]},
    {"type": "chaupai", "number": 17, "lines": ["కేహరి వాహన సోహ భవానీ ।", "లాంగుర వీర చలత అగవానీ ॥ 17 ॥"]},
    {"type": "chaupai", "number": 18, "lines": ["కర మేం ఖప్పర ఖడగ విరాజే ।", "జాకో దేఖ కాల డర భాజే ॥ 18 ॥"]},
    {"type": "chaupai", "number": 19, "lines": ["తోహే కర మేం అస్త్ర త్రిశూలా ।", "జాతే ఉఠత శత్రు హియ శూలా ॥ 19 ॥"]},
    {"type": "chaupai", "number": 20, "lines": ["నగరకోటి మేం తుమ్హీం విరాజత ।", "తిహుఁ లోక మేం డంకా బాజత ॥ 20 ॥"]},
    {"type": "chaupai", "number": 21, "lines": ["శుంభ నిశుంభ దానవ తుమ మారే ।", "రక్తబీజ శంఖన సంహారే ॥ 21 ॥"]},
    {"type": "chaupai", "number": 22, "lines": ["మహిషాసుర నృప అతి అభిమానీ ।", "జేహి అఘ భార మహీ అకులానీ ॥ 22 ॥"]},
    {"type": "chaupai", "number": 23, "lines": ["రూప కరాల కాలికా ధారా ।", "సేన సహిత తుమ తిహి సంహారా ॥ 23 ॥"]},
    {"type": "chaupai", "number": 24, "lines": ["పడీ భీఢ సంతన పర జబ జబ ।", "భయి సహాయ మాతు తుమ తబ తబ ॥ 24 ॥"]},
    {"type": "chaupai", "number": 25, "lines": ["అమరపురీ అరు బాసవ లోకా ।", "తబ మహిమా సబ కహేం అశోకా ॥ 25 ॥"]},
    {"type": "chaupai", "number": 26, "lines": ["జ్వాలా మేం హై జ్యోతి తుమ్హారీ ।", "తుమ్హేం సదా పూజేం నర నారీ ॥ 26 ॥"]},
    {"type": "chaupai", "number": 27, "lines": ["ప్రేమ భక్తి సే జో యశ గావేమ్ ।", "దుఃఖ దారిద్ర నికట నహిం ఆవేమ్ ॥ 27 ॥"]},
    {"type": "chaupai", "number": 28, "lines": ["ధ్యావే తుమ్హేం జో నర మన లాయి ।", "జన్మ మరణ తే సౌం ఛుట జాయి ॥ 28 ॥"]},
    {"type": "chaupai", "number": 29, "lines": ["జోగీ సుర ముని కహత పుకారీ ।", "యోగ న హోయి బిన శక్తి తుమ్హారీ ॥ 29 ॥"]},
    {"type": "chaupai", "number": 30, "lines": ["శంకర ఆచారజ తప కీనో ।", "కామ అరు క్రోధ జీత సబ లీనో ॥ 30 ॥"]},
    {"type": "chaupai", "number": 31, "lines": ["నిశిదిన ధ్యాన ధరో శంకర కో ।", "కాహు కాల నహిం సుమిరో తుమకో ॥ 31 ॥"]},
    {"type": "chaupai", "number": 32, "lines": ["శక్తి రూప కో మరమ న పాయో ।", "శక్తి గయీ తబ మన పఛతాయో ॥ 32 ॥"]},
    {"type": "chaupai", "number": 33, "lines": ["శరణాగత హుయి కీర్తి బఖానీ ।", "జయ జయ జయ జగదంబ భవానీ ॥ 33 ॥"]},
    {"type": "chaupai", "number": 34, "lines": ["భయి ప్రసన్న ఆది జగదంబా ।", "దయి శక్తి నహిం కీన విలంబా ॥ 34 ॥"]},
    {"type": "chaupai", "number": 35, "lines": ["మోకో మాతు కష్ట అతి ఘేరో ।", "తుమ బిన కౌన హరై దుఃఖ మేరో ॥ 35 ॥"]},
    {"type": "chaupai", "number": 36, "lines": ["ఆశా తృష్ణా నిపట సతావేమ్ ।", "రిపు మూరఖ మొహి అతి దర పావైమ్ ॥ 36 ॥"]},
    {"type": "chaupai", "number": 37, "lines": ["శత్రు నాశ కీజై మహారానీ ।", "సుమిరౌం ఇకచిత తుమ్హేం భవానీ ॥ 37 ॥"]},
    {"type": "chaupai", "number": 38, "lines": ["కరో కృపా హే మాతు దయాలా ।", "ఋద్ధి-సిద్ధి దే కరహు నిహాలా ॥ 38 ॥"]},
    {"type": "chaupai", "number": 39, "lines": ["జబ లగి జియూ దయా ఫల పావూ ।", "తుమ్హరో యశ మైం సదా సునావూ ॥ 39 ॥"]},
    {"type": "chaupai", "number": 40, "lines": ["దుర్గా చాలీసా జో గావై ।", "సబ సుఖ భోగ పరమపద పావై ॥ 40 ॥"]},
    {"type": "doha", "lines": ["దేవీదాస శరణ నిజ జానీ ।", "కరహు కృపా జగదంబ భవానీ ॥"]}
  ]
}

{
  "id": "durga-chalisa",
  "title": "દુર્ગા ચાલીસા",
  "lyrics": [
    {"type": "chaupai", "number": 1, "lines": ["નમો નમો દુર્ગે સુખ કરની ।", "નમો નમો અંબે દુઃખ હરની ॥ 1 ॥"]},
    {"type": "chaupai", "number": 2, "lines": ["નિરંકાર હૈ જ્યોતિ તુમ્હારી ।", "તિહૂ લોક ફૈલી ઉજિયારી ॥ 2 ॥"]},
    {"type": "chaupai", "number": 3, "lines": ["શશિ લલાટ મુખ મહાવિશાલા ।", "નેત્ર લાલ ભૃકુટિ વિકરાલા ॥ 3 ॥"]},
    {"type": "chaupai", "number": 4, "lines": ["રૂપ માતુ કો અધિક સુહાવે ।", "દરશ કરત જન અતિ સુખ પાવે ॥ 4 ॥"]},
    {"type": "chaupai", "number": 5, "lines": ["તુમ સંસાર શક્તિ લય કીના ।", "પાલન હેતુ અન્ન ધન દીના ॥ 5 ॥"]},
    {"type": "chaupai", "number": 6, "lines": ["અન્નપૂર્ણા હુયિ જગ પાલા ।", "તુમ હી આદિ સુંદરી બાલા ॥ 6 ॥"]},
    {"type": "chaupai", "number": 7, "lines": ["પ્રલયકાલ સબ નાશન હારી ।", "તુમ ગૌરી શિવ શંકર પ્યારી ॥ 7 ॥"]},
    {"type": "chaupai", "number": 8, "lines": ["શિવ યોગી તુમ્હરે ગુણ ગાવેમ્ ।", "બ્રહ્મા વિષ્ણુ તુમ્હેં નિત ધ્યાવેમ્ ॥ 8 ॥"]},
    {"type": "chaupai", "number": 9, "lines": ["રૂપ સરસ્વતી કા તુમ ધારા ।", "દે સુબુદ્ધિ ઋષિ મુનિન ઉબારા ॥ 9 ॥"]},
    {"type": "chaupai", "number": 10, "lines": ["ધરા રૂપ નરસિંહ કો અંબા ।", "પરગટ ભયિ ફાડ કે ખંબા ॥ 10 ॥"]},
    {"type": "chaupai", "number": 11, "lines": ["રક્ષા કર પ્રહ્લાદ બચાયો ।", "હિરણ્યાક્ષ કો સ્વર્ગ પઠાયો ॥ 11 ॥"]},
    {"type": "chaupai", "number": 12, "lines": ["લક્ષ્મી રૂપ ધરો જગ માહીમ્ ।", "શ્રી નારાયણ અંગ સમાહીમ્ ॥ 12 ॥"]},
    {"type": "chaupai", "number": 13, "lines": ["ક્ષીરસિંધુ મેં કરત વિલાસા ।", "દયાસિંધુ દીજૈ મન આસા ॥ 13 ॥"]},
    {"type": "chaupai", "number": 14, "lines": ["હિંગલાજ મેં તુમ્હીં ભવાની ।", "મહિમા અમિત ન જાત બખાની ॥ 14 ॥"]},
    {"type": "chaupai", "number": 15, "lines": ["માતંગી ધૂમાવતિ માતા ।", "ભુવનેશ્વરી બગલા સુખદાતા ॥ 15 ॥"]},
    {"type": "chaupai", "number": 16, "lines": ["શ્રી ભૈરવ તારા જગ તારિણી ।", "છિન્ન ભાલ ભવ દુઃખ નિવારિણી ॥ 16 ॥"]},
    {"type": "chaupai", "number": 17, "lines": ["કેહરિ વાહન સોહ ભવાની ।", "લાંગુર વીર ચલત અગવાની ॥ 17 ॥"]},
    {"type": "chaupai", "number": 18, "lines": ["કર મેં ખપ્પર ખડગ વિરાજે ।", "જાકો દેખ કાલ ડર ભાજે ॥ 18 ॥"]},
    {"type": "chaupai", "number": 19, "lines": ["તોહે કર મેં અસ્ત્ર ત્રિશૂલા ।", "જાતે ઉઠત શત્રુ હિય શૂલા ॥ 19 ॥"]},
    {"type": "chaupai", "number": 20, "lines": ["નગરકોટિ મેં તુમ્હીં વિરાજત ।", "તિહુઁ લોક મેં ડંકા બાજત ॥ 20 ॥"]},
    {"type": "chaupai", "number": 21, "lines": ["શુંભ નિશુંભ દાનવ તુમ મારે ।", "રક્તબીજ શંખન સંહારે ॥ 21 ॥"]},
    {"type": "chaupai", "number": 22, "lines": ["મહિષાસુર નૃપ અતિ અભિમાની ।", "જેહિ અઘ ભાર મહી અકુલાની ॥ 22 ॥"]},
    {"type": "chaupai", "number": 23, "lines": ["રૂપ કરાલ કાલિકા ધારા ।", "સેન સહિત તુમ તિહિ સંહારા ॥ 23 ॥"]},
    {"type": "chaupai", "number": 24, "lines": ["પડી ભીઢ સંતન પર જબ જબ ।", "ભયિ સહાય માતુ તુમ તબ તબ ॥ 24 ॥"]},
    {"type": "chaupai", "number": 25, "lines": ["અમરપુરી અરુ બાસવ લોકા ।", "તબ મહિમા સબ કહેં અશોકા ॥ 25 ॥"]},
    {"type": "chaupai", "number": 26, "lines": ["જ્વાલા મેં હૈ જ્યોતિ તુમ્હારી ।", "તુમ્હેં સદા પૂજેં નર નારી ॥ 26 ॥"]},
    {"type": "chaupai", "number": 27, "lines": ["પ્રેમ ભક્તિ સે જો યશ ગાવેમ્ ।", "દુઃખ દારિદ્ર નિકટ નહિં આવેમ્ ॥ 27 ॥"]},
    {"type": "chaupai", "number": 28, "lines": ["ધ્યાવે તુમ્હેં જો નર મન લાયિ ।", "જન્મ મરણ તે સૌં છુટ જાયિ ॥ 28 ॥"]},
    {"type": "chaupai", "number": 29, "lines": ["જોગી સુર મુનિ કહત પુકારી ।", "યોગ ન હોયિ બિન શક્તિ તુમ્હારી ॥ 29 ॥"]},
    {"type": "chaupai", "number": 30, "lines": ["શંકર આચારજ તપ કીનો ।", "કામ અરુ ક્રોધ જીત સબ લીનો ॥ 30 ॥"]},
    {"type": "chaupai", "number": 31, "lines": ["નિશિદિન ધ્યાન ધરો શંકર કો ।", "કાહુ કાલ નહિં સુમિરો તુમકો ॥ 31 ॥"]},
    {"type": "chaupai", "number": 32, "lines": ["શક્તિ રૂપ કો મરમ ન પાયો ।", "શક્તિ ગયી તબ મન પછતાયો ॥ 32 ॥"]},
    {"type": "chaupai", "number": 33, "lines": ["શરણાગત હુયિ કીર્તિ બખાની ।", "જય જય જય જગદંબ ભવાની ॥ 33 ॥"]},
    {"type": "chaupai", "number": 34, "lines": ["ભયિ પ્રસન્ન આદિ જગદંબા ।", "દયિ શક્તિ નહિં કીન વિલંબા ॥ 34 ॥"]},
    {"type": "chaupai", "number": 35, "lines": ["મોકો માતુ કષ્ટ અતિ ઘેરો ।", "તુમ બિન કૌન હરૈ દુઃખ મેરો ॥ 35 ॥"]},
    {"type": "chaupai", "number": 36, "lines": ["આશા તૃષ્ણા નિપટ સતાવેમ્ ।", "રિપુ મૂરખ મોહિ અતિ દર પાવૈમ્ ॥ 36 ॥"]},
    {"type": "chaupai", "number": 37, "lines": ["શત્રુ નાશ કીજૈ મહારાની ।", "સુમિરૌં ઇકચિત તુમ્હેં ભવાની ॥ 37 ॥"]},
    {"type": "chaupai", "number": 38, "lines": ["કરો કૃપા હે માતુ દયાલા ।", "ઋદ્ધિ-સિદ્ધિ દે કરહુ નિહાલા ॥ 38 ॥"]},
    {"type": "chaupai", "number": 39, "lines": ["જબ લગિ જિયૂ દયા ફલ પાવૂ ।", "તુમ્હરો યશ મૈં સદા સુનાવૂ ॥ 39 ॥"]},
    {"type": "chaupai", "number": 40, "lines": ["દુર્ગા ચાલીસા જો ગાવૈ ।", "સબ સુખ ભોગ પરમપદ પાવૈ ॥ 40 ॥"]},
    {"type": "doha", "lines": ["દેવીદાસ શરણ નિજ જાની ।", "કરહુ કૃપા જગદંબ ભવાની ॥"]}
  ]
}

{
  "id": "achyutam-keshavam",
  "title": "అచ్యుతం కేశవం",
  "lyrics": [
    {
      "type": "chorus",
      "lines": [
        "అచ్యుతం కేశవం కృష్ణ దామోదరం,",
        "రామ నారాయణం జానకీవల్లభం ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "కవున్ కెహ్తే హే భగవాన్ ఆతే నహి,",
        "తుం మీరా కే జైసే బులాతే నహి ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "అచ్యుతం కేశవం కృష్ణ దామోదరం,",
        "రామ నారాయణం జానకీవల్లభం ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "కవున్ కెహ్తే హే భగవాన్ ఖాతే నహి,",
        "బేర్ శబరి కే జైసే ఖిలతే నహి ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "అచ్యుతం కేశవం కృష్ణ దామోదరం,",
        "రామ నారాయణం జానకీవల్లభం ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "కవున్ కెహ్తే హే భగవాన్ నాచతే నహి,",
        "గోపియో కి తరః తుం నచాతే నహి ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "అచ్యుతం కేశవం కృష్ణ దామోదరం,",
        "రామ నారాయణం జానకీవల్లభం ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "కవున్ కెహ్తే హే భగవాన్ సోతే నహి,",
        "మా యశోద కే జైసే సులతే నహి ।"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "అచ్యుతం కేశవం కృష్ణ దామోదరం,",
        "రామ నారాయణం జానకీవల్లభం ।"
      ]
    }
  ]
}

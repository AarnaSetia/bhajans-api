{
  "id": "omkar-pradhan-rupa-ganeshantse",
  "title": "Omkar Pradhan Rupa Ganeshache",
  "lyrics": [
    {
      "type": "chorus",
      "lines": [
        "Omkar Pradhan Rupa Ganeshache,",
        "He Tinhi Devanche Janmasthana ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Akar To Bramha, Ukara To Vishnu,",
        "Makar Mahesha Zaniyela ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Aise Tinhi Deva, Jethuni Utpanna,",
        "To Ha Gajanan Mayabapa ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Tuka Mhane Aisi, Ahe Vedwani,",
        "Pahavi Purani Vyasachiya ।"
      ]
    }
  ]
}

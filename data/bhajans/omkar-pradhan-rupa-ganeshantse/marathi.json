{
  "id": "omkar-pradhan-rupa-ganeshantse",
  "title": "ओंकार प्रधान रूप गणेशाचे",
  "lyrics": [
    {
      "type": "chorus",
      "lines": [
        "ओंकार प्रधान रूप गणेशाचे,",
        "हे तिन्ही देवांचे जन्मस्थान ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "आकार तो ब्रम्हा, उकार तो विष्णू,",
        "मकार महेश जाणियेला ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "ऐसे तिन्ही देव जेथोनि उत्पन्न,",
        "तो हा गजानन मायबाप ।"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "तुका म्हणे ऐसी आहे वेदवाणी,",
        "पहावी पुराणी व्यासाचिया ।"
      ]
    }
  ]
}

{
  "id": "om-namah-shivaya",
  "title": "ॐ नमः शिवाय",
  "lyrics": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "ॐ नमः शिवाय, ॐ नमः शिवाय,",
        "हर हर भोले, नमः शिवाय ॥ 1 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "रामेश्वराय शिव रामेश्वराय,",
        "हर हर भोले, नमः शिवाय ॥ 2 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "गंगाधराय शिव गंगाधराय,",
        "हर हर भोले, नमः शिवाय ॥ 3 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 4,
      "lines": [
        "जटाधराय शिव जटाधराय,",
        "हर हर भोले, नमः शिवाय ॥ 4 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 5,
      "lines": [
        "सोमेश्वराय शिव सोमेश्वराय,",
        "हर हर भोले, नमः शिवाय ॥ 5 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 6,
      "lines": [
        "विश्वेश्वराय शिव विश्वेश्वराय,",
        "हर हर भोले, नमः शिवाय ॥ 6 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 7,
      "lines": [
        "कोटेश्वराय शिव कोटेश्वराय,",
        "हर हर भोले, नमः शिवाय ॥ 7 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 8,
      "lines": [
        "महाकालेश्वराय महाकालेश्वराय,",
        "हर हर भोले, नमः शिवाय ॥ 8 ॥"
      ]
    }
  ]
}

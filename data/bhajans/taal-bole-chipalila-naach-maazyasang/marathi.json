{
  "id": "taal-bole-chipalila-naach-maazyasang",
  "title": "टाळ बोले चिपळीला, नाच माझ्या संग",
  "lyrics": [
    {
      "type": "verse",
      "lines": [
        "टाळ बोले चिपळीला, नाच माझ्या संग",
        "देवाजीच्या दारी आज, रंगला अभंग"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "दरबारी आले, रंक आणि राव",
        "सारे एकरूप, नाही भेदभाव",
        "गाऊ नाचू सारे या हो",
        "गाऊ नाचू सारे या हो, होऊनी निःसंग"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "देवाजीच्या दारी आज, रंगला अभंग"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "जन सेवेपायी, काया झिजवावी",
        "घाव सोसुनिया, मने रिझवावी",
        "घाव सोसुनिया, मने रिझवावी",
        "ताल देऊनी हा, ताल देऊनी हा",
        "बोलतो मृदुंग"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "देवाजीच्या दारी आज, रंगला अभंग"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "ब्रह्मानंदे देह, बुडोनिया जाई",
        "एक एक खांब, वारकरी होई",
        "कैलासाचा नाथ, कैलासाचा नाथ",
        "झाला पांडुरंग"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "देवाजीच्या दारी आज, रंगला अभंग",
        "टाळ बोले चिपळीला, नाच माझ्या संग",
        "देवाजीच्या दारी आज, रंगला अभंग"
      ]
    }
  ]
}

{
  "id": "taal-bole-chipalila-naach-maazyasang",
  "title": "Taal Bole Chipalila, Naach Maazyasang",
  "lyrics": [
    {
      "type": "verse",
      "lines": [
        "Taal Bole Chipalila, Naach Maazyasang",
        "Devachiya Dwari Aaj, Rangla Abhang"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "Darbari Aale, Rank Ani Rao",
        "Saare Ekroop, Naahi Bhedbhaav",
        "Gaau Naachu Saare, Ho",
        "Gaau Naachu Saare Houni Nihsang"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Devajichya Dwaari Aaj, Rangla Abhang"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "Jansevepayi, Kaaya Zijvavi",
        "Ghaav Sosuniyaa, Mane Rangvavi",
        "Ghaav Sosuniyaa, Mane Rangvavi",
        "Taal Deuni Ha, Taal Deuni Ha",
        "Bolto Mrudang"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Devajichya Dwari Aaj, Rangla Abhang"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "Brahmanandi Deh, Buduniya Jaai",
        "Ek Ek Khamb, Warkari Hoi",
        "Kailasa Nath, Kailasa Nath",
        "Jhala Pandurang"
      ]
    },
    {
      "type": "verse",
      "lines": [
        "Devajichya Dwari Aaj, Rangla Abhang",
        "Taal Bole Chipalila, Naach Maazyasang",
        "Devachiya Dwari Aaj, Rangla Abhang"
      ]
    }
  ]
}

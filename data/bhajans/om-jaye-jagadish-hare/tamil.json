    {"type": "verse", "number": 4, "lines": ["தும பூரண பரமாத்மா,", "தும அந்தரயாமீ,", "ஸ்வாமீ தும அந்தரயாமீ,", "பரப்³ரஹ்ம பரமேஶ்வர,", "பரப்³ரஹ்ம பரமேஶ்வர,", "தும ஸப³ கே ஸ்வாமீ,", "ஓம் ஜய ஜக³தீ³ஶ ஹரே ॥ 4 ॥"]},
    {"type": "verse", "number": 5, "lines": ["தும கருணா கே ஸாக³ர,", "தும பாலனகர்தா,", "ஸ்வாமீ தும பாலனகர்தா,", "மைம் மூரக² க²ல காமீ,", "மைம் ஸேவக தும ஸ்வாமீ,", "க்ருபா கரோ ப⁴ர்தார,", "ஓம் ஜய ஜக³தீ³ஶ ஹரே ॥ 5 ॥"]},
    {"type": "verse", "number": 6, "lines": ["தும ஹோ ஏக அகோ³சர,", "ஸப³கே ப்ராணபதி,", "ஸ்வாமீ ஸப³கே ப்ராணபதி,", "கிஸ வித⁴ மிலூம் த³யாமய,", "கிஸ வித⁴ மிலூம் த³யாமய,", "துமகோ மைம் குமதி,", "ஓம் ஜய ஜக³தீ³ஶ ஹரே ॥ 6 ॥"]},

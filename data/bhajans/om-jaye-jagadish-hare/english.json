{
  "id": "om-jaye-jagadish-hare",
  "title": "Om Jai Jagadish Hare",
  "lyrics": [
    {"type": "verse", "number": 1, "lines": ["ōṃ jaya jagadīśa harē,", "svāmī jaya jagadīśa harē,", "bhakta janōṃ kē saṅkaṭa,", "dāsa janōṃ kē saṅkaṭa,", "kṣaṇa mēṃ dūra karē,", "ōṃ jaya jagadīśa harē ॥ 1 ॥"]},
    {"type": "verse", "number": 2, "lines": ["jō dhyāvē phala pāvē,", "dukha binasē mana kā,", "svāmī dukha binasē mana kā,", "sukha sammati ghara āvē,", "sukha sammati ghara āvē,", "kaṣṭa miṭē tana kā,", "ōṃ jaya jagadīśa harē ॥ 2 ॥"]},
    {"type": "verse", "number": 3, "lines": ["māta pitā tuma mērē,", "śaraṇa gahūṃ maiṃ kisakī,", "svāmī śaraṇa gahūṃ maiṃ kisakī,", "tuma bina aura na dūjā,", "tuma bina aura na dūjā,", "āsa karūṃ maiṃ jisakī,", "ōṃ jaya jagadīśa harē ॥ 3 ॥"]},
    {"type": "verse", "number": 4, "lines": ["tuma pūraṇa paramātmā,", "tuma antarayāmī,", "svāmī tuma antarayāmī,", "parabrahma paramēśvara,", "parabrahma paramēśvara,", "tuma saba kē svāmī,", "ōṃ jaya jagadīśa harē ॥ 4 ॥"]},
    {"type": "verse", "number": 5, "lines": ["tuma karuṇā kē sāgara,", "tuma pālanakartā,", "svāmī tuma pālanakartā,", "maiṃ mūrakha khala kāmī,", "maiṃ sēvaka tuma svāmī,", "kṛpā karō bhartāra,", "ōṃ jaya jagadīśa harē ॥ 5 ॥"]},
    {"type": "verse", "number": 6, "lines": ["tuma hō ēka agōchara,", "sabakē prāṇapati,", "svāmī sabakē prāṇapati,", "kisa vidha milūṃ dayāmaya,", "kisa vidha milūṃ dayāmaya,", "tumakō maiṃ kumati,", "ōṃ jaya jagadīśa harē ॥ 6 ॥"]},
    {"type": "verse", "number": 7, "lines": ["dīnabandhu dukhahartā,", "ṭhākura tuma mērē,", "svāmī tuma mērē,", "apanē hātha uṭhāvō,", "apanī śaraṇa lagāvō,", "dvāra paḍā tērē,", "ōṃ jaya jagadīśa harē ॥ 7 ॥"]},
    {"type": "verse", "number": 8, "lines": ["viṣaya vikāra miṭāvō,", "pāpa harō dēvā,", "svāmī pāpa harō dēvā,", "śraddhā bhakti baḍhāvō,", "śraddhā bhakti baḍhāvō,", "santana kī sēvā,", "ōṃ jaya jagadīśa harē ॥ 8 ॥"]}
  ]
}

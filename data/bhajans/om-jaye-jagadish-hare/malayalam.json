{
  "id": "om-jaye-jagadish-hare",
  "title": "ഓം ജയ ജഗദീശ ഹരേ",
  "lyrics": [
    {"type": "verse", "number": 1, "lines": ["ഓം ജയ ജഗദീശ ഹരേ,", "സ്വാമീ ജയ ജഗദീശ ഹരേ,", "ഭക്ത ജനോം കേ സംകട,", "ദാസ ജനോം കേ സംകട,", "ക്ഷണ മേം ദൂര കരേ,", "ഓം ജയ ജഗദീശ ഹരേ ॥ 1 ॥"]},
    {"type": "verse", "number": 2, "lines": ["ജോ ധ്യാവേ ഫല പാവേ,", "ദുഖ ബിനസേ മന കാ,", "സ്വാമീ ദുഖ ബിനസേ മന കാ,", "സുഖ സമ്മതി ഘര ആവേ,", "സുഖ സമ്മതി ഘര ആവേ,", "കഷ്ട മിടേ തന കാ,", "ഓം ജയ ജഗദീശ ഹരേ ॥ 2 ॥"]},
    {"type": "verse", "number": 3, "lines": ["മാത പിതാ തുമ മേരേ,", "ശരണ ഗഹൂം മൈം കിസകീ,", "സ്വാമീ ശരണ ഗഹൂം മൈം കിസകീ,", "തുമ ബിന ഔര ന ദൂജാ,", "തുമ ബിന ഔര ന ദൂജാ,", "ആസ കരൂം മൈം ജിസകീ,", "ഓം ജയ ജഗദീശ ഹരേ ॥ 3 ॥"]},
    {"type": "verse", "number": 4, "lines": ["തുമ പൂരണ പരമാത്മാ,", "തുമ അംതരയാമീ,", "സ്വാമീ തുമ അംതരയാമീ,", "പരബ്രഹ്മ പരമേശ്വര,", "പരബ്രഹ്മ പരമേശ്വര,", "തുമ സബ കേ സ്വാമീ,", "ഓം ജയ ജഗദീശ ഹരേ ॥ 4 ॥"]},
    {"type": "verse", "number": 5, "lines": ["തുമ കരുണാ കേ സാഗര,", "തുമ പാലനകര്‍താ,", "സ്വാമീ തുമ പാലനകര്‍താ,", "മൈം മൂരഖ ഖല കാമീ,", "മൈം സേവക തുമ സ്വാമീ,", "കൃപാ കരോ ഭര്‍താര,", "ഓം ജയ ജഗദീശ ഹരേ ॥ 5 ॥"]},
    {"type": "verse", "number": 6, "lines": ["തുമ ഹോ ഏക അഗോചര,", "സബകേ പ്രാണപതി,", "സ്വാമീ സബകേ പ്രാണപതി,", "കിസ വിധ മിലൂം ദയാമയ,", "കിസ വിധ മിലൂം ദയാമയ,", "തുമകോ മൈം കുമതി,", "ഓം ജയ ജഗദീശ ഹരേ ॥ 6 ॥"]},
    {"type": "verse", "number": 7, "lines": ["ദീനബംധു ദുഖഹര്‍താ,", "ഠാകുര തുമ മേരേ,", "സ്വാമീ തുമ മേരേ,", "അപനേ ഹാഥ ഉഠാവോ,", "അപനീ ശരണ ലഗാവോ,", "ദ്വാര പഡാ തേരേ,", "ഓം ജയ ജഗദീശ ഹരേ ॥ 7 ॥"]},
    {"type": "verse", "number": 8, "lines": ["വിഷയ വികാര മിടാവോ,", "പാപ ഹരോ ദേവാ,", "സ്വാമീ പാപ ഹരോ ദേവാ,", "ശ്രദ്ധാ ഭക്തി ബഢാവോ,", "ശ്രദ്ധാ ഭക്തി ബഢാവോ,", "സംതന കീ സേവാ,", "ഓം ജയ ജഗദീശ ഹരേ ॥ 8 ॥"]}

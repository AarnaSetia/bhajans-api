  "lyrics": [
    {"type": "verse", "number": 1, "lines": ["ઓં જય જગદીશ હરે,", "સ્વામી જય જગદીશ હરે,", "ભક્ત જનોં કે સંકટ,", "દાસ જનોં કે સંકટ,", "ક્ષણ મેં દૂર કરે,", "ઓં જય જગદીશ હરે ॥ 1 ॥"]},

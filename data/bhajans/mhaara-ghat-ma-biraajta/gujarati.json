{
  "id": "mhaara-ghat-ma-biraajta",
  "title": "મારા ઘટ માં બિરાજતા",
  "lyrics": [
    {
      "type": "doha",
      "lines": [
        "મારા ઘટ માં બિરાજતા,",
        "શ્રી નાથજી યમુનાજી શ્રી મહાપ્રભુજી"
      ]
    },
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "મારું મનડું છે ગોકુલ વનરાવન,",
        "મારા મન ના આંગણિયા માં તુલસી ના વન,",
        "મારા પ્રાણ જીવન,",
        "મારા ઘટ માં બિરાજતા,",
        "શ્રી નાથજી યમુનાજી શ્રી મહાપ્રભુજી ॥ 1 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "મારા આતમનાં આંગણે શ્રી મહા પ્રભુજી,",
        "મારી આંખો વિષે ગિરધારી રે ધારી,",
        "મારું તન મન ગયું જેને વારી રે વારી,",
        "મારા શ્યામ મોરારિ,",
        "મારા ઘટ માં બિરાજતા,",
        "શ્રી નાથજી યમુનાજી શ્રી મહાપ્રભુજી ॥ 2 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "મારા પ્રાણ થકી મને વૈષ્ણવ વહાલા,",
        "નિત કરતા શ્રી નાથજી ને કાલારે વાલા,",
        "મેં તો વલ્લભ પ્રભુજી ના કીધા છે દર્શન,",
        "મારું મોહી લીધું મન,",
        "મારા ઘટ માં બિરાજતા,",
        "શ્રી નાથજી યમુનાજી શ્રી મહાપ્રભુજી ॥ 3 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 4,
      "lines": [
        "હું તો નિત્ય વિઠ્ઠલવર ની સેવા રે કરું,",
        "હું તો આઠે સમા કેરી ઝાંખી રે કરું,",
        "મેં તો ચિતડું શ્રીનાથજી ને ચરણે ધર્યુ,",
        "જીવન સફ્ળ કર્યું,",
        "મારા ઘટ માં બિરાજતા,",
        "શ્રી નાથજી યમુનાજી શ્રી મહાપ્રભુજી ॥ 4 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 5,
      "lines": [
        "મેં તો ભક્તિ મારગ કેરો સંગ રે સાધ્યો,",
        "મેં તો પુષ્ટિ મારગ કેરો સંગ રે સાધ્યો,",
        "મન ઘોળી કીર્તન કેરો રંગ રે લાગ્યો,",
        "મને લાલ ની લાલી કેરો રંગ રે લાગ્યો,",
        "હીરલો હાથ લાગ્યો,",
        "મારા ઘટ માં બિરાજતા,",
        "શ્રી નાથજી યમુનાજી શ્રી મહાપ્રભુજી ॥ 5 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 6,
      "lines": [
        "આવો જીવન માં લહાવો કદી ફરી ના મળે,",
        "વારે વારે માનવ દેહ ફરી ના મળે,",
        "ફેરો લખ રે ચોર્યાચી નો મારો રે ફળે,",
        "મને મોહન મળે,",
        "મારા ઘટ માં બિરાજતા,",
        "શ્રી નાથજી યમુનાજી શ્રી મહાપ્રભુજી ॥ 6 ॥"
      ]
    },
    {
      "type": "verse",
      "number": 7,
      "lines": [
        "મારી અંત સમય કેરી સુણો રે અરજી,",
        "લેજો ચરણો માં શ્રીનાથ બાવા દયા રે કરી,",
        "મને તેડાં રે યમ કેરા કદી ના આવે,",
        "મારો નાથ તેડાવે,",
        "મારા ઘટ માં બિરાજતા,",
        "શ્રી નાથજી યમુનાજી શ્રી મહાપ્રભુજી ॥ 7 ॥"
      ]
    }
  ]
}

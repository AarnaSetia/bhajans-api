{
  "id": "krishna-nee-begane-baro",
  "title": "ಕೃಷ್ಣ ನೀ ಬೇಗನೇ ಬಾರೋ",
  "lyrics": [
    {
      "type": "verse",
      "lines": [
        "ಕೃಷ್ಣ ನೀ ಬೇಗನೇ ಬಾರೋ",
        "ಬೇಗನೆ ಬಾರೋ ನೀ ಮುಖವನ್ನು ತೋರೋ"
      ]
    },
    {
      "type": "chaupai",
      "number": 1,
      "lines": [
        "ಕಾಲಾಲಂದುಗೆ ಗೆಜ್ಜೆ ನೀಲದ ಭಾವುಲಿ",
        "ನೀಲವರ್ಣನೆ ನಾಟ್ಯವಾಡುತೆ ಬಾರೋ"
      ]
    },
    {
      "type": "chaupai",
      "number": 2,
      "lines": [
        "ಉಡಿಯಲ್ಲಿ ಉಡುಗೆಜ್ಜೆ ಬೆರಳಲ್ಲಿ ಉಂಗುರ",
        "ಕೊರಳಲ್ಲಿ ಹಾಕಿದ ವೈಜಯಂತಿಮಾಲ"
      ]
    },
    {
      "type": "chaupai",
      "number": 3,
      "lines": [
        "ಕಾಶೀ ಪೀತಾಂಬರ ಕೈಯಲ್ಲಿ ಕೊಳಲು",
        "ಪೂಸಿದ ಶ್ರೀ ಗಂಧ ಮೈಯೊಳು ಘಮಘಮ"
      ]
    },
    {
      "type": "chaupai",
      "number": 4,
      "lines": [
        "ತಾಯಿಗೆ ಬಾಯಲ್ಲಿ ಜಗವನ್ನು ತೋರಿದ",
        "ಜಗದೋದ್ಧಾರಕ ನಮ್ಮ ಉಡುಪಿ ಶ್ರೀ ಕೃಷ್ಣ"
      ]
    }
  ]
}

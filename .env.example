# Copy this file to .env for local dev (`npm run dev`).
# On Netlify, set these under Site settings → Environment variables instead.

# Required — Gemini formatting/validation
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Required ONLY for live "Save" (commits files to GitHub from the hosted site).
# A GitHub Personal Access Token with contents:write on the repo.
# Not needed for local dev — local Save writes straight to disk.
# GITHUB_TOKEN=your-github-pat-here

# Optional — override the repo / branch the live Save commits to
# GITHUB_REPO=AarnaSetia/bhajans-api
# GITHUB_BRANCH=main

# Optional — Firebase web API key used to verify admin login tokens on the
# server. Defaults to the public shcs-2949a key; override only if it changes.
# FIREBASE_API_KEY=...
